{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
  ],
  rebaseWhen: 'auto',
  dockerfile: {
    managerFilePatterns: [
      '/(^|/)Containerfile$/',
      '/(^|/)Dockerfile$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Containerfile$/',
      ],
      matchStrings: [
        'ARG NERD_FONTS_VERSION=(?<currentValue>v[\\d\\.]+)',
      ],
      depNameTemplate: 'ryanoasis/nerd-fonts',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)Justfile$/',
      ],
      matchStrings: [
        'bib_image\\s*:=\\s*"(?<depName>[^:]+):(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      automerge: true,
      matchUpdateTypes: [
        'pin',
        'pinDigest',
        'digest',
      ],
    },
    {
      automerge: true,
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
        'pinDigest',
      ],
    },
    {
      automerge: true,
      matchUpdateTypes: [
        'patch',
      ],
    },
    {
      automerge: true,
      matchDatasources: [
        'github-releases',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      pinDigests: true,
    },
    {
      matchPackageNames: [
        'fedora',
      ],
      enabled: false,
    },
    {
      // Keep the Bazzite base tracking the floating :stable tag.
      // Do NOT pin its digest — this is a rolling image that rebuilds daily to
      // follow upstream, and a digest pin forces a full ~8GB re-pull each build.
      matchPackageNames: [
        'ghcr.io/ublue-os/bazzite',
      ],
      pinDigests: false,
      enabled: false,
    },
  ],
}
