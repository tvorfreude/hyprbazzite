{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "auto",

  // Ensure Renovate detects 'Containerfile' (not just 'Dockerfile')
  "dockerfile": {
    "fileMatch": ["(^|/)Containerfile$", "(^|/)Dockerfile$"]
  },

  // Track custom version ARGs in the Containerfile
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Containerfile$"],
      "matchStrings": [
        "ARG NERD_FONTS_VERSION=(?<currentValue>v[\\d\\.]+)"
      ],
      "depNameTemplate": "ryanoasis/nerd-fonts",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)Justfile$"],
      "matchStrings": [
        "bib_image\\s*:=\\s*\"(?<depName>[^:]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    }
  ],

  "packageRules": [
    {
      // Auto-merge all pin/digest updates (low risk — same code, just pinning)
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest", "digest"]
    },
    {
      // Auto-merge minor and patch updates for GitHub Actions
      "automerge": true,
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"]
    },
    {
      // Auto-merge patch updates for everything else (Containerfile deps, etc.)
      "automerge": true,
      "matchUpdateTypes": ["patch"]
    },
    {
      // Auto-merge minor updates for GitHub releases (nerd-fonts, etc.)
      "automerge": true,
      "matchDatasources": ["github-releases"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      // Pin GitHub Actions by SHA
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
