#!/usr/bin/env bash
# wallpaper-cycle - Cycle through GIF wallpapers using awww
#
# This script sets a random GIF wallpaper from the configured directory,
# cycles it at regular intervals, re-applies it when monitors are hotplugged,
# and on SIGUSR1 puts a wallpaper back on screen (hyprbazzite-ctl sends that
# to the PID in $XDG_RUNTIME_DIR/wallpaper-cycle.pid - the process name is
# "bash", so pgrep/pkill by name never find it).

set -euo pipefail

# hypr_instance_alive, hypr_instance_lock
source /usr/lib/hyprbazzite/hypr/scripts/lib/common.sh

# -- Configuration -----------------------------------------------------------
readonly DIR="/usr/share/backgrounds/gif_wallpapers"
readonly TRANSITION_TYPE="grow"
readonly TRANSITION_POS="0.5,0.5"
readonly TRANSITION_FPS=30
readonly TRANSITION_STEP=90
readonly TRANSITION_DURATION=2
readonly CYCLE_INTERVAL=900  # seconds (15 minutes)
readonly FILTER="${WALLPAPER_FILTER:-Nearest}"  # Nearest keeps GIFs crisp; set WALLPAPER_FILTER=Lanczos3 to smooth-scale photos
readonly WALLUST_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/wallust"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
readonly CURRENT_FILE="$RUNTIME_DIR/wallpaper-current"
readonly PID_FILE="$RUNTIME_DIR/wallpaper-cycle.pid"

# -- Helpers ------------------------------------------------------------------

cycle_now() {
    # Skip if user has pinned a wallpaper via the wallpaper picker
    if [[ -f "${RUNTIME_DIR}/wallpaper-pinned" ]]; then
        return 0
    fi

    # Re-scan directory (in case files change)
    if [[ ! -d "$DIR" ]]; then
        return 1
    fi

    local files=("$DIR"/*.gif)
    # Check if directory is not empty
    if [[ ${#files[@]} -eq 0 || ! -e "${files[0]}" ]]; then
        return 1
    fi

    local wallpaper="${files[RANDOM % ${#files[@]}]}"
    if [[ -f "$wallpaper" ]]; then
        awww img \
            --transition-type "$TRANSITION_TYPE" \
            --transition-pos "$TRANSITION_POS" \
            --transition-fps "$TRANSITION_FPS" \
            --transition-step "$TRANSITION_STEP" \
            --transition-duration "$TRANSITION_DURATION" \
            --resize crop \
            --filter "$FILTER" \
            "$wallpaper"
        printf '%s\n' "$wallpaper" > "$CURRENT_FILE"

        # hyprlock.conf's background.path reads a static frame from here - it
        # has no idea awww or GIF cycling exist, so without this it's stuck
        # showing whatever the wallpaper picker last set (or nothing at all,
        # rendering black, if that picker was never used). Keep it in sync
        # with whatever's actually on screen; "[0]" grabs the GIF's first
        # frame since a lock screen can't animate.
        if command -v magick &>/dev/null; then
            mkdir -p "$WALLUST_DIR"
            magick "${wallpaper}[0]" "$WALLUST_DIR/current_wallpaper.png" 2>/dev/null || true

            # Mirror to the shared, world-readable location the SDDM
            # greeter theme reads from (see tmpfiles.d) - it can't reach
            # into $HOME to read the copy above.
            cp "$WALLUST_DIR/current_wallpaper.png" /var/lib/hyprbazzite/theme/current_wallpaper.png 2>/dev/null || true

            # Accent follows the wallpaper only in "auto" mode (no-op otherwise)
            /usr/libexec/hyprbazzite-accent apply --if-auto >/dev/null 2>&1 || true
        fi
    fi
}

# Put what is already showing on every output again - a newly connected or
# re-detected monitor comes up without it. Not a new random pick (which used
# to happen on every hotplug and every post-resume re-probe), and no frame
# extraction or accent work: nothing about the wallpaper changed.
reapply_current() {
    local current=""
    if [[ -f "${RUNTIME_DIR}/wallpaper-pinned" ]]; then
        current="$WALLUST_DIR/current_wallpaper.jpg"   # the picker's copy
    elif [[ -r "$CURRENT_FILE" ]]; then
        current=$(<"$CURRENT_FILE")
    fi
    [[ -f "$current" ]] || return 0
    awww img --transition-type none --resize crop --filter "$FILTER" "$current"
}

# SIGUSR1: hyprbazzite-ctl sends it right after restarting awww-daemon
# (Refresh Session, gamemode off), when nothing is showing. A new random GIF,
# or the pinned picture again while one is pinned - cycle_now alone skips a
# pinned wallpaper, which left the desktop blank.
on_usr1() {
    if [[ -f "${RUNTIME_DIR}/wallpaper-pinned" ]]; then
        reapply_current
    else
        cycle_now
    fi
}

# -- Monitor hotplug listener ------------------------------------------------

monitor_hotplug() {
    udevadm monitor --udev --subsystem-match=drm | \
    while read -r line; do
        [[ "$line" == *change* ]] || continue
        # A hotplug or a resume re-probe arrives as a burst of events, one per
        # connector: let it settle (bounded), then re-apply once.
        for _ in {1..30}; do read -r -t 2 _ || break; done
        hypr_instance_alive || exit 0
        reapply_current || true
    done
}

cleanup() {
    if [[ -n "${sleep_pid:-}" ]]; then
        kill "$sleep_pid" 2>/dev/null || true
    fi
    if [[ -n "${hotplug_pid:-}" ]]; then
        pkill -P "$hotplug_pid" 2>/dev/null || true
        kill "$hotplug_pid" 2>/dev/null || true
    fi
    if [[ "$(cat "$PID_FILE" 2>/dev/null)" == "$$" ]]; then
        rm -f "$PID_FILE"
    fi
}

# -- Main ---------------------------------------------------------------------

main() {
    # One instance per Hyprland instance (autostart can't de-duplicate by
    # process name: this runs as "bash").
    hypr_instance_lock wallpaper-cycle || exit 0

    # Turn termination into a normal exit so the EXIT trap always runs and
    # takes the hotplug listener (and its udevadm) down too.
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap cleanup EXIT
    # `|| true`: under set -e, a failing command inside a trap handler
    # (awww-daemon briefly unavailable, say) would end the daemon.
    trap 'on_usr1 || true' USR1
    # Only now advertise the PID: hyprbazzite-ctl sends USR1 to it, and before
    # the handler above exists that signal's default action ends the process.
    echo "$$" > "$PID_FILE"

    # Initial delay to ensure awww daemon is ready
    sleep 2
    cycle_now || true

    # Background children get `9>&-` so they never hold the instance lock:
    # anything left behind with it (the interval sleep used to be) would make
    # a restart in the same Hyprland instance exit silently.
    monitor_hotplug 9>&- &
    hotplug_pid=$!

    # Interruptible sleep: a USR1 cuts it short (the trap has already
    # cycled), and the interval starts over.
    while hypr_instance_alive; do
        sleep "$CYCLE_INTERVAL" 9>&- &
        sleep_pid=$!
        if wait "$sleep_pid"; then
            # Re-check first: after a logout/login within one interval the
            # same WAYLAND_DISPLAY belongs to the new session.
            hypr_instance_alive || break
            cycle_now || true
        else
            kill "$sleep_pid" 2>/dev/null || true
        fi
    done
}

main "$@"
