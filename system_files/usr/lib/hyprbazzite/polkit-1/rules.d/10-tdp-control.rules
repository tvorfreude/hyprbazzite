// Polkit rule to allow users in the 'wheel' group to use TDP control without password.
// Only in an active local session (not SSH), and only for the exact command
// lines hyprbazzite-ctl runs through pkexec: pkexec hands rules the full
// command line, program first as an absolute path. Anything else these tools
// can do as root (temperature and current limits, curve offsets...) still
// needs authentication - matching the program alone allowed all of it.
polkit.addRule(function(action, subject) {
    if (action.id != "org.freedesktop.policykit.exec" ||
        !subject.local || !subject.active || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }
    var cmd = action.lookup("command_line") || "";
    var m;

    if (/^\/usr\/s?bin\/(ryzenadj --info|amdctl info)$/.test(cmd)) {
        return polkit.Result.YES;
    }
    // One limit for STAPM/fast/slow, in mW, 3-120 W.
    m = /^\/usr\/s?bin\/ryzenadj --stapm-limit=(\d+) --fast-limit=\1 --slow-limit=\1$/.exec(cmd);
    if (m && +m[1] >= 3000 && +m[1] <= 120000) {
        return polkit.Result.YES;
    }
    m = /^\/usr\/s?bin\/amdctl set power-limit (\d+)$/.exec(cmd);
    if (m && +m[1] >= 3 && +m[1] <= 120) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
