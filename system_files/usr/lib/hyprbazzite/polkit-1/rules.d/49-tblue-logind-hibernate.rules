// Wheel users in an active local session may suspend-then-hibernate (logind
// checks the hibernate actions for it) without a prompt, also while other
// sessions exist. Not -ignore-inhibit: inhibitors still apply.
polkit.addRule(function(action, subject) {
    var allowed = [
        "org.freedesktop.login1.hibernate",
        "org.freedesktop.login1.hibernate-multiple-sessions"
    ];

    if (allowed.indexOf(action.id) >= 0 && subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
