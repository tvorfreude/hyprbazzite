# Lock screen after 5 minutes (skip if already locked)
timeout 300 'pgrep -x hyprlock || hyprlock -c /etc/hypr/hyprlock.conf'

# Turn off displays after 10 minutes
timeout 600 'hyprctl dispatch dpms off'
resume 'hyprctl dispatch dpms on'

# Lock before the system suspends (skip if already locked)
before-sleep 'pgrep -x hyprlock || hyprlock -c /etc/hypr/hyprlock.conf'
