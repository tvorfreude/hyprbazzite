// ╔══════════════════════════════════════════════════════════════╗
// ║        Waybar — macOS-style translucent bar (Dracula)        ║
// ║  Left:  launcher · focused app name · workspaces             ║
// ║  Right: system drawer · status icons · notifications · clock ║
// ╚══════════════════════════════════════════════════════════════╝

{
  // ── Bar geometry ──────────────────────────────────────────────
  "layer": "top",
  "mode": "dock",
  "position": "top",
  "height": 30,
  "exclusive": true,
  "passthrough": false,
  "spacing": 0,
  "ipc": true,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "reload_style_on_change": true,

  // ── Layout ────────────────────────────────────────────────────
  "modules-left": [
    "custom/menu",
    "custom/appname",
    "hyprland/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "group/system",
    "custom/idle",
    "custom/power-profiles-daemon",
    "tray",
    "custom/headset-battery",
    "pulseaudio",
    "pulseaudio#microphone",
    "battery",
    "custom/notification",
    "clock"
  ],

  // ════════════════════════════════════════════════════════════════
  // LEFT
  // ════════════════════════════════════════════════════════════════

  "custom/menu": {
    "format": "",
    "on-click": "wofi --show drun --conf /etc/wofi/config --style /etc/wofi/style.css",
    "on-click-right": "/usr/libexec/hyprbazzite-ctl power menu",
    "tooltip": true,
    "tooltip-format": "App Launcher\nRight-click: power menu"
  },

  // Focused application name (the macOS "app menu" slot, minus the menus).
  // Long-running: resolves the window class to its real .desktop Name on each
  // focus change, so there is no rename list to maintain.
  "custom/appname": {
    "return-type": "json",
    "exec": "/usr/libexec/hyprbazzite-ctl waybar app-name",
    "max-length": 28
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "disable-scroll": false,
    "warp-on-scroll": false,
    "on-click": "activate",
    "on-scroll-up":   "hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace = \"e-1\"}))'",
    "on-scroll-down": "hyprctl eval 'hl.dispatch(hl.dsp.focus({workspace = \"e+1\"}))'"
  },

  // ════════════════════════════════════════════════════════════════
  // RIGHT
  // ════════════════════════════════════════════════════════════════

  // System stats live behind one drawer: hover the chip icon to expand
  "group/system": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 400,
      "children-class": "cpu",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "disk",
      "custom/temperature"
    ]
  },

  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "format-alt": "{usage}% 󰍛",
    "tooltip-format": "CPU {usage}%",
    "on-click-right": "kitty -e btop"
  },

  "memory": {
    "interval": 10,
    "format": "{used:0.1f}G 󰾆",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB ({percentage}%)",
    "on-click-right": "kitty -e btop"
  },

  "disk": {
    "interval": 30,
    "path": "/var",
    "format": "{percentage_used}% 󰋊",
    "tooltip-format": "{used} used of {total}"
  },

  "custom/temperature": {
    "return-type": "json",
    "exec": "/usr/libexec/hyprbazzite-ctl automation temp",
    "interval": 10,
    "on-click-right": "kitty -e btop"
  },

  // Mirrors the swaync "Awake" toggle: both read/flip whether hypridle runs.
  "custom/idle": {
    "return-type": "json",
    "exec": "/usr/libexec/hyprbazzite-ctl waybar idle-status",
    "interval": 30,
    "signal": 9,
    "on-click": "/usr/libexec/hyprbazzite-ctl qs awake toggle"
  },

  "custom/power-profiles-daemon": {
    "return-type": "json",
    "exec": "/usr/libexec/hyprbazzite-ctl waybar power-status",
    "interval": 30,
    "signal": 8,
    "on-click":       "/usr/libexec/hyprbazzite-ctl power profile",
    "on-click-right": "/usr/libexec/hyprbazzite-ctl tdp profile"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/headset-battery": {
    "format": "󰋋 {}%",
    "exec": "/usr/libexec/hyprbazzite-ctl waybar headset-battery",
    "interval": 60,
    "on-click": "solaar",
    "return-type": "integer"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿","󰖀","󰕾"]
    },
    "ignored-sinks": ["Easy Effects Sink"],
    "scroll-step": 5.0,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol -t 3",
    "on-scroll-up":   "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}\nClick: mute  Right: mixer  Scroll: volume",
    "smooth-scrolling-threshold": 1
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "pavucontrol -t 4",
    "on-scroll-up":   "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%-",
    "tooltip-format": "{source_desc} · {source_volume}%\nClick: mute  Right: mixer",
    "scroll-step": 5,
    "smooth-scrolling-threshold": 1
  },

  "battery": {
    "full-at": 100,
    "design-capacity": false,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "format-time": "{H}h {M}min",
    "tooltip-format": "{timeTo} — {power}W",
    "on-click-right": "/usr/libexec/hyprbazzite-ctl power menu",
    "on-scroll-up":   "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "smooth-scrolling-threshold": 1
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification":               "<span foreground='#ff79c6'>󰂚</span>",
      "none":                       "󰂚",
      "dnd-notification":           "<span foreground='#ff79c6'>󰂛</span>",
      "dnd-none":                   "󰂛",
      "inhibited-notification":     "<span foreground='#ff79c6'>󰂚</span>",
      "inhibited-none":             "󰂚",
      "dnd-inhibited-notification": "<span foreground='#ff79c6'>󰂛</span>",
      "dnd-inhibited-none":         "󰂛"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click":       "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // Hover for the calendar (unchanged), left-click toggles long date,
  // right-click flips month/year view, scroll moves through months.
  "clock": {
    "interval": 30,
    "format": "{:%a %b %d  %I:%M %p}",
    "format-alt": "{:%A, %d %B %Y  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#f8f8f2'><b>{}</b></span>",
        "days":     "<span color='#bd93f9'><b>{}</b></span>",
        "weeks":    "<span color='#50fa7b'><b>W{:%V}</b></span>",
        "weekdays": "<span color='#f1fa8c'><b>{}</b></span>",
        "today":    "<span color='#ff79c6'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right":    "mode",
      "on-click-forward":  "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up":      "shift_up",
      "on-scroll-down":    "shift_down"
    }
  }
}
