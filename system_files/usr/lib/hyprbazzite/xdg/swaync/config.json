{
    "$schema": "/etc/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-layer": "top",
    "control-center-margin-top": 6,
    "control-center-margin-bottom": 6,
    "control-center-margin-right": 6,
    "control-center-margin-left": 6,
    "notification-2fa-action": true,
    "notification-inline-replies": true,
    "notification-window-width": 440,
    "image-visibility": "when-available",
    "keyboard-shortcuts": true,
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,
    "scripts": {
        "sound": {
            "exec": "canberra-gtk-play -i message-new-instant",
            "app-name": "^(?!Battery$)",
            "run-on": "receive"
        },
        "battery-low": {
            "exec": "canberra-gtk-play -i battery-caution",
            "app-name": "^Battery$",
            "urgency": "Normal",
            "run-on": "receive"
        },
        "battery-critical": {
            "exec": "canberra-gtk-play -i battery-low",
            "app-name": "^Battery$",
            "urgency": "Critical",
            "run-on": "receive"
        }
    },
    "widgets": [
        "buttons-grid",
        "mpris",
        "volume",
        "backlight#intel",
        "backlight#amd0",
        "backlight#amd1",
        "title",
        "dnd",
        "notifications"
    ],
    "widget-config": {
        "label": {
            "text": "Control Center"
        },
        "title": {
            "text": "Notifications",
            "clear-all-button": true,
            "button-text": "Clear All"
        },
        "dnd": {
            "text": "Do Not Disturb"
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰖩\nWi-Fi",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs wifi state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs wifi set"
                },
                {
                    "label": "󰂯\nBT",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs bluetooth state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs bluetooth set"
                },
                {
                    "label": "󰝟\nSpeaker",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs speakers state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs speakers set"
                },
                {
                    "label": "󰍭\nMic",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs mic state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs mic set"
                },
                {
                    "label": "󰅶\nAwake",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs awake state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs awake set"
                },
                {
                    "label": "󰖔\nNight",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs nightlight state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs nightlight set"
                },
                {
                    "label": "󰊴\nGame",
                    "type": "toggle",
                    "active": false,
                    "update-command": "/usr/libexec/hyprbazzite-ctl qs gamemode state",
                    "command": "/usr/libexec/hyprbazzite-ctl qs gamemode set"
                },
                {
                    "label": "󰓅\nProfile",
                    "command": "/usr/libexec/hyprbazzite-ctl power profile"
                },
                {
                    "label": "󰌌\nKeys",
                    "command": "/usr/libexec/hyprbazzite-ctl osk toggle"
                },
                {
                    "label": "󰹑\nShot",
                    "command": "/usr/libexec/hyprbazzite-ctl qs screenshot run"
                },
                {
                    "label": "󰒓\nSettings",
                    "command": "/usr/libexec/hyprbazzite-ctl settings"
                },
                {
                    "label": "󰐥\nPower",
                    "command": "/usr/libexec/hyprbazzite-ctl power menu"
                }
            ]
        },
        "volume": {
            "label": "󰕾"
        },
        "mpris": {
            "show-album-art": "always",
            "autohide": true
        },
        "backlight#intel": {
            "label": "󰃠",
            "device": "intel_backlight"
        },
        "backlight#amd0": {
            "label": "󰃠",
            "device": "amdgpu_bl0"
        },
        "backlight#amd1": {
            "label": "󰃠",
            "device": "amdgpu_bl1"
        }
    },
    "control-center-width": 480
}