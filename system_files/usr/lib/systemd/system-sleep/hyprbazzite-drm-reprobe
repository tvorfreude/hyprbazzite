#!/usr/bin/env bash
# hyprbazzite-drm-reprobe - re-detect monitors that vanish across suspend
#
# After S3, amdgpu can report a DP/HDMI monitor that was in standby as
# "disconnected" until its connector is re-probed. Writing "detect" to the
# connector's status re-probes it (Hyprland handles the hotplug), retried for
# a few seconds since monitors wake slowly. The retries run as a transient
# unit: systemd-suspend.service kills hook processes left behind.

set -u

reprobe() {
    local c
    for c in /sys/class/drm/card*-DP-* /sys/class/drm/card*-HDMI-A-*; do
        [[ -w "$c/status" ]] || continue
        [[ "$(cat "$c/status" 2>/dev/null)" == "disconnected" ]] || continue
        echo detect > "$c/status" 2>/dev/null || true
    done
}

case "${1:-}" in
    post)
        reprobe
        # No fixed unit name: one still running from the last resume would
        # block it.
        systemd-run --no-block --collect --quiet \
            --description="Re-probe DRM connectors after resume" \
            /usr/lib/systemd/system-sleep/hyprbazzite-drm-reprobe retry || true
        ;;
    retry)
        for delay in 2 3 5; do sleep "$delay"; reprobe; done
        ;;
esac
