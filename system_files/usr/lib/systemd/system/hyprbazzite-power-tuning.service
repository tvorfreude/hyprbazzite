[Unit]
Description=HyprBazzite PCIe ASPM power tuning (runtime)
After=local-fs.target
# One rpm-ostree transaction at a time (see tblue-hibernate-setup.service).
After=bazzite-hardware-setup.service tblue-hibernate-setup.service
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/hyprbazzite-power-tuning
RemainAfterExit=yes
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
