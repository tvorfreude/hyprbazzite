[Unit]
Description=HyprBazzite PCIe ASPM power tuning (runtime)
After=local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/hyprbazzite-power-tuning
RemainAfterExit=yes
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
