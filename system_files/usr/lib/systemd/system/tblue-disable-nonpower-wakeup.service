[Unit]
Description=Disable non-power/lid wakeup sources (bag-safe: USB/PCIe/etc. can't wake it, power button and lid still can)
# Random USB/PCIe/Thunderbolt bus activity (e.g. being jostled in a bag) must
# not wake the machine, but the power button and opening the lid - like a
# real laptop - should. See hypr/scripts/disable-nonpower-wakeup.sh.
# /proc/acpi/wakeup settings persist for the boot session (across
# suspend/resume) and reset on reboot, so running once at boot is sufficient.
After=multi-user.target
ConditionPathExists=/proc/acpi/wakeup
# Laptops (and handhelds) only. On a desktop this left only the power button
# able to wake it - no keyboard, mouse or Wake-on-LAN - while
# hyprbazzite-deep-sleep-setup puts desktops into S3. A battery is the same
# "this is a laptop" signal hyprbazzite-battery.service and that unit use.
ConditionPathExistsGlob=/sys/class/power_supply/BAT*

[Service]
Type=oneshot
ExecStart=/usr/lib/hyprbazzite/hypr/scripts/disable-nonpower-wakeup.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
