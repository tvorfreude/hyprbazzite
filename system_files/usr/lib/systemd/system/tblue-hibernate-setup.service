[Unit]
Description=TBlue Hibernate first-boot provisioning
After=local-fs.target
# rpm-ostree fails concurrent transactions, so karg changes run in sequence:
# bazzite-hardware-setup, this, power-tuning, deep-sleep-setup.
After=bazzite-hardware-setup.service
DefaultDependencies=no
# Until the setup marks itself done (v2 labels the swapfile for SELinux;
# re-running skips whatever is already done).
ConditionPathExists=!/var/lib/tblue/hibernate-setup-v2.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/tblue-hibernate-setup
RemainAfterExit=yes
Nice=19
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
