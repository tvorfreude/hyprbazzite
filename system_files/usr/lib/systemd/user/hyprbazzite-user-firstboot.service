[Unit]
Description=HyprBazzite per-user first-login setup
# %S is the user's state dir (~/.local/state). Skip once the marker exists.
# v2: also migrates ~/.config links into /usr to writable copies, so accounts
# that only have the original user-firstboot.done marker run once more.
ConditionPathExists=!%S/hyprbazzite/user-firstboot-v2.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/hyprbazzite-user-firstboot
RemainAfterExit=yes

[Install]
WantedBy=default.target
