#!/usr/bin/env bash
set -euo pipefail

# ===============================================================================
# HyprBazzite Control Center (hyprbazzite-ctl)
# A unified manager for the entire HyprBazzite desktop.
#
# Modules: menu, gamemode, screenshot, wallpaper, chezmoi, refresh,
#          quicksettings, theme, tdp, osk, power, automation, keybinds, lid
# ===============================================================================

# --- Shared Library ---
source /usr/lib/hyprbazzite/hypr/scripts/lib/common.sh 2>/dev/null || true

# Fallbacks if common.sh failed to load
command -v notify >/dev/null 2>&1 || notify() {
    local title="$1" msg="$2" urgency="${3:-normal}"
    command -v notify-send >/dev/null 2>&1 && notify-send -u "$urgency" "$title" "$msg"
}
command -v json_escape >/dev/null 2>&1 || json_escape() {
    local s="$1"; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '%s' "$s"
}
: "${CONFIG_DIR:="${XDG_CONFIG_HOME:-$HOME/.config}"}"

# ═══════════════════════════════════════════════════════════════════════════════
# MENU MODULE — interactive launcher (replaces TritonCtl)
# ═══════════════════════════════════════════════════════════════════════════════

# 1 if Hyprland animations are on, 0 if off. `hyprctl getoption` prints
# "bool: true" on this build (older builds printed "int: 1"), so asking for
# JSON and normalising both shapes avoids comparing against the wrong literal.
_animations_enabled() {
    local v
    v=$(hyprctl -j getoption animations:enabled 2>/dev/null \
        | jq -r 'if has("bool") then (if .bool then 1 else 0 end) else (.int // 1) end' 2>/dev/null)
    echo "${v:-1}"
}

menu_show() {
    local gamemode_status="Gamemode (disabled)"
    local gamemode_enabled
    gamemode_enabled=$(_animations_enabled)
    [[ "$gamemode_enabled" == "0" ]] && gamemode_status="Gamemode (enabled)"

    local options
    options=$(cat <<EOF
$gamemode_status
Screenshot
Wallpaper
Refresh Session
Quick Settings
Accent Colour
Workspace Layout
Theme Update
Power Menu
TDP Profile
OSK Toggle
Keybind Profile
Chezmoi Push
Chezmoi Pull
EOF
)

    local choice
    choice=$(echo "$options" | wofi -dmenu -p "HyprBazzite" -i) || return 0

    case "$choice" in
        *"Gamemode"*)     gamemode_toggle ;;
        "Screenshot")     screenshot_take "region" ;;
        "Wallpaper")      wallpaper_pick ;;
        "Refresh Session") session_refresh ;;
        "Quick Settings") quicksettings_show ;;
        "Accent Colour")  accent_menu ;;
        "Workspace Layout") workspace_layout_menu ;;
        "Theme Update")   theme_update ;;
        "Power Menu")     power_menu ;;
        "TDP Profile")    tdp_menu ;;
        "OSK Toggle")     osk_toggle ;;
        "Keybind Profile") keybinds_switch "toggle" ;;
        "Chezmoi Push")   chezmoi_action "push" ;;
        "Chezmoi Pull")   chezmoi_action "pull" ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# GAMEMODE MODULE
# ═══════════════════════════════════════════════════════════════════════════════

# Wallpapers here are animated GIFs played by awww. Gamemode blanks them with
# `awww clear`, so remember what was showing (per output) and put exactly that
# back; falling back to the static current_wallpaper.png froze the animation.
_gamemode_wall_state() { echo "${XDG_RUNTIME_DIR:-/tmp}/hyprbazzite-gamemode-wallpaper"; }

_save_wallpaper() {
    command -v awww &>/dev/null || return 0
    local out
    out=$(awww query 2>/dev/null | grep -F "image: ") || return 0
    [[ -n "$out" ]] && printf '%s\n' "$out" > "$(_gamemode_wall_state)"
}

# wallpaper-cycle runs under bash, so its process name is "bash" and
# `pgrep -x wallpaper-cycle` never found it; it records its PID instead.
# The cmdline check guards against a stale file pointing at a reused PID.
_wallpaper_cycle_pid() {
    local pid
    pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/wallpaper-cycle.pid" 2>/dev/null) || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && grep -qa wallpaper-cycle "/proc/$pid/cmdline" 2>/dev/null || return 1
    echo "$pid"
}

_restore_wallpaper() {
    local state out name img restored=0
    state=$(_gamemode_wall_state)
    if command -v awww &>/dev/null && [[ -s "$state" ]]; then
        while IFS= read -r line; do
            name=$(sed -n 's/^: *\([^:]*\):.*/\1/p' <<<"$line")
            img=${line##*image: }
            [[ -n "$name" && -f "$img" ]] || continue
            awww img -o "$name" "$img" --transition-type wipe --transition-duration 2 && restored=1
        done < "$state"
        rm -f "$state"
    fi
    (( restored )) && return 0

    # Nothing saved (e.g. gamemode was enabled before this fix): let the cycle
    # daemon pick a fresh GIF if it is running, else the static fallback.
    local pid
    if pid=$(_wallpaper_cycle_pid); then
        kill -USR1 "$pid" || true
        return 0
    fi
    local f
    for f in "$CONFIG_DIR/hypr/wallust/current_wallpaper.jpg" "$CONFIG_DIR/hypr/wallust/current_wallpaper.png"; do
        if [[ -f "$f" ]]; then
            if command -v awww &>/dev/null; then
                awww img "$f" --transition-type wipe --transition-duration 2
            else
                swaybg -i "$f" -m fill &
            fi
            return 0
        fi
    done
}

gamemode_toggle() {
    local notif_icon="$HOME/.config/swaync/images/ja.png"
    local enabled
    enabled=$(_animations_enabled)

    if [[ "$enabled" = "1" ]]; then
        # This build's Hyprland config is a native Lua engine ("non-legacy
        # parser"), so `hyprctl keyword` always errors - live changes have to
        # go through `hyprctl eval` calling the same hl.* API the config uses.
        hyprctl eval 'hl.config({
            animations = { enabled = false },
            decoration = { shadow = { enabled = false }, blur = { enabled = false }, rounding = 0, active_opacity = 1.0, inactive_opacity = 1.0 },
            general = { gaps_in = 0, gaps_out = 0, border_size = 1 },
        })
        hl.window_rule({ match = { class = ".*" }, opacity = "1 override 1 override 1 override" })' >/dev/null
        _save_wallpaper
        if command -v awww &>/dev/null; then
            awww clear 000000 2>/dev/null || true
        else
            pkill swaybg || true
        fi
        notify-send -e -u low -i "$notif_icon" " Gamemode:" " enabled"
    else
        # A reload, not a mirror-image eval: re-running the config restores
        # gaps/blur/animations exactly as hyprland.lua has them, and drops the
        # gamemode window rule above. Countering it with another
        # `opacity = "1 override"` rule (as this used to) overrode rules.lua's
        # inactive opacity for every window until the next reload, and each
        # toggle stacked two more rules.
        _reload_config
        _restore_wallpaper
        sleep 0.5
        notify-send -e -u normal -i "$notif_icon" " Gamemode:" " disabled"
    fi
}

# `hyprctl reload` re-evaluates the Lua config from scratch, which also drops
# what was applied at runtime through `hyprctl eval`: the workspace-to-monitor
# rules (workspace_rebind) and the night-light shader. Put those back.
_reload_config() {
    local nightlight=0
    [[ "$(qs nightlight state 2>/dev/null)" == true ]] && nightlight=1
    hyprctl reload >/dev/null
    workspace_rebind
    if (( nightlight )); then SWAYNC_TOGGLE_STATE=true qs nightlight set; fi
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════════
# SCREENSHOT MODULE
# ═══════════════════════════════════════════════════════════════════════════════

screenshot_take() {
    local mode="${1:-region}"
    local output_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}"
    local timestamp filename geo

    if [[ ! -d "$output_dir" ]]; then
        notify "Screenshot" "Directory does not exist: $output_dir" "critical"
        return 1
    fi

    timestamp=$(date +'%Y-%m-%d_%H-%M-%S')
    filename="screenshot-$timestamp.png"

    _screenshot_editor() {
        if command -v satty &>/dev/null; then
            satty --filename - --output-filename "$output_dir/$filename" \
                --early-exit --actions-on-enter save-to-clipboard \
                --save-after-copy --copy-command wl-copy
        elif command -v swappy &>/dev/null; then
            swappy -f - -o "$output_dir/$filename"
        else
            cat > "$output_dir/$filename"
        fi
    }

    if command -v hyprshot &>/dev/null; then
        pkill slurp || true
        case "$mode" in
            clipboard) hyprshot -m region --raw | wl-copy; notify "Screenshot" "Copied to clipboard" ;;
            window)    hyprshot -m window --raw | _screenshot_editor ;;
            output)    hyprshot -m output --raw | _screenshot_editor ;;
            *)         hyprshot -m region --raw | _screenshot_editor ;;
        esac
    elif command -v grim &>/dev/null; then
        pkill slurp || true
        case "$mode" in
            clipboard) geo=$(slurp) || return 0; grim -g "$geo" - | wl-copy; notify "Screenshot" "Copied to clipboard" ;;
            # macOS Shift+3: the focused screen, saved + copied straight away (no editor)
            full|output)
                local mon
                mon=$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .name' 2>/dev/null | head -n1)
                if [[ -n "$mon" ]]; then grim -o "$mon" "$output_dir/$filename"; else grim "$output_dir/$filename"; fi
                [[ -s "$output_dir/$filename" ]] || { notify "Screenshot" "Capture failed" "critical"; return 1; }
                wl-copy < "$output_dir/$filename"
                notify "Screenshot" "Saved to $filename and copied" ;;
            # macOS Shift+5-style: click a window on the current workspace
            window)
                geo=$(hyprctl -j clients 2>/dev/null | jq -r --argjson ws "$(hyprctl -j activeworkspace 2>/dev/null | jq '.id')" \
                    '.[] | select(.mapped and .workspace.id == $ws) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' 2>/dev/null \
                    | slurp -r) || return 0
                grim -g "$geo" - | _screenshot_editor ;;
            # macOS Shift+4 (area/region, the default): drag a region, then edit/save
            *)         geo=$(slurp) || return 0; grim -g "$geo" - | _screenshot_editor ;;
        esac
    else
        notify "Screenshot" "No screenshot tool found (hyprshot or grim)" "critical"
        return 1
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# WALLPAPER MODULE
# ═══════════════════════════════════════════════════════════════════════════════

wallpaper_pick() {
    local wall_dir="$HOME/Pictures/wallpapers"
    local wallust_dir="$CONFIG_DIR/hypr/wallust"
    local wallust_current="$wallust_dir/current_wallpaper.jpg"

    if ! command -v magick &>/dev/null; then
        notify "Wallpaper" "Missing dependency: imagemagick" "critical"
        return 1
    fi

    mapfile -d '' wall_files < <(find "$wall_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" -o -iname "*.bmp" -o -iname "*.webp" \) -print0 2>/dev/null)
    if [[ ${#wall_files[@]} -eq 0 ]]; then
        notify "Wallpaper" "No wallpapers found in $wall_dir" "critical"
        return 1
    fi

    local random_wall="${wall_files[$((RANDOM % ${#wall_files[@]}))]}"

    _generate_list() {
        echo -e "Random\x00icon\x1f$random_wall"
        for wall in "${wall_files[@]}"; do
            local fname label
            fname=$(basename "$wall")
            label="${fname%.*}"
            printf "%s\x00icon\x1f%s\n" "$label" "$wall"
        done | sort
    }

    local choice
    choice=$(_generate_list | wofi -dmenu -p "Wallpaper" -i) || return 0

    local wall_path=""
    if [[ "$choice" = "Random" ]]; then
        wall_path="$random_wall"
    else
        wall_path=$(find "$wall_dir" -type f -name "$choice.*" -print -quit)
    fi

    if [[ -n "$wall_path" && -f "$wall_path" ]]; then
        mkdir -p "$wallust_dir"
        magick "$wall_path" "$wallust_dir/current_wallpaper.png"
        cp "$wall_path" "$wallust_current"
        touch "${XDG_RUNTIME_DIR:-/tmp}/wallpaper-pinned"

        # Mirror to the shared, world-readable location the SDDM greeter
        # theme reads from (see tmpfiles.d) - it can't reach into $HOME.
        cp "$wallust_dir/current_wallpaper.png" /var/lib/hyprbazzite/theme/current_wallpaper.png 2>/dev/null || true

        # Accent follows the wallpaper only in "auto" mode (no-op otherwise)
        /usr/libexec/hyprbazzite-accent apply --if-auto >/dev/null 2>&1 || true

        if command -v wallust &>/dev/null; then
            wallust run "$wallust_current" -s
            _reload_config
        fi

        if command -v awww &>/dev/null; then
            awww img "$wallust_current" --transition-type wipe --transition-duration 2
        else
            pkill swaybg || true
            swaybg -i "$wallust_current" -m fill &
        fi
        notify "Wallpaper" "Set to $(basename "$wall_path")"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# CHEZMOI MODULE
# ═══════════════════════════════════════════════════════════════════════════════

chezmoi_action() {
    local action="${1:-}"

    if ! command -v chezmoi &>/dev/null; then
        notify "Chezmoi" "chezmoi not installed" "critical"
        return 1
    fi

    case "$action" in
        push)
            notify "Chezmoi" "Preparing push..."
            if chezmoi git -- status --porcelain | grep -q .; then
                local logfile="/tmp/chezmoi-push-$(date +%s).log"
                chezmoi git -- add -A &>>"$logfile"
                chezmoi git -- commit -m "chezmoi: update $(date -u +"%Y-%m-%dT%H:%M:%SZ")" &>>"$logfile" || true
                if chezmoi git -- push &>>"$logfile"; then
                    notify "Chezmoi" "Changes pushed successfully"
                else
                    notify "Chezmoi" "Push failed — see $logfile" "critical"
                fi
            else
                notify "Chezmoi" "No local changes to push"
            fi
            ;;
        pull)
            local choice
            choice=$(echo -e "Yes\nNo" | wofi -dmenu -p "Pull and apply chezmoi changes?" -i) || return 0
            [[ "$choice" != "Yes" ]] && { notify "Chezmoi" "Pull cancelled"; return 0; }
            notify "Chezmoi" "Pulling and applying dotfiles..."
            local logfile="/tmp/chezmoi-pull-$(date +%s).log"
            if chezmoi git -- pull --rebase --autostash &>>"$logfile"; then
                if chezmoi apply &>>"$logfile"; then
                    notify "Chezmoi" "Pull and apply succeeded"
                else
                    notify "Chezmoi" "Apply failed — see $logfile" "critical"
                fi
            else
                notify "Chezmoi" "Git pull failed — see $logfile" "critical"
            fi
            ;;
        *)
            echo "Usage: hyprbazzite-ctl chezmoi [push|pull]"
            return 1
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# SESSION REFRESH MODULE
# ═══════════════════════════════════════════════════════════════════════════════

session_refresh() {
    local apps=(hypridle waybar fcitx5 awww-daemon)
    for app in "${apps[@]}"; do
        pkill -x "$app" || true
    done

    sleep 0.3
    # Same command lines as autostart.lua: a bare `waybar` finds no config on
    # this image (it lives in /etc/waybar) and exits, leaving no bar at all.
    hypridle -c /etc/hypr/hypridle.conf &
    waybar --config /etc/waybar/config.jsonc --style "$(/usr/libexec/hyprbazzite-accent style waybar)" &
    fcitx5 &
    awww-daemon &
    # swaync (this image's notification daemon) reloads in place.
    swaync-client -R -rs >/dev/null 2>&1 || true
    sleep 0.5

    local pid
    if pid=$(_wallpaper_cycle_pid); then
        kill -USR1 "$pid" || true
    elif [[ -f "$CONFIG_DIR/hypr/wallust/current_wallpaper.jpg" ]]; then
        awww img "$CONFIG_DIR/hypr/wallust/current_wallpaper.jpg" --transition-type wipe --transition-duration 2
    fi
    notify "HyprBazzite" "Session apps refreshed"
}

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK SETTINGS MODULE
# ═══════════════════════════════════════════════════════════════════════════════

quicksettings_show() {
    local wofi_config="$CONFIG_DIR/wofi/config"

    local gtk_mode
    gtk_mode=$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || echo "")
    local mode_label="(light mode)"
    [[ "$gtk_mode" == "'prefer-dark'" ]] && mode_label="(dark mode)"

    local options="Choose Kitty Terminal Theme\nGTK Settings (nwg-look)\nQT Apps Settings (qt6ct)\nQT Apps Settings (qt5ct)\nSwitch Dark-Light Theme $mode_label"
    local choice
    choice=$(echo -e "$options" | wofi -i -dmenu -p "Configuration") || return 0

    case "$choice" in
        "Choose Kitty Terminal Theme"*)
            local kitty_theme_dir="$CONFIG_DIR/kitty/themes"
            if [[ ! -d "$kitty_theme_dir" ]]; then
                notify "Settings" "Kitty themes directory not found."
                return 1
            fi
            local themes selected_theme
            themes=$(ls "$kitty_theme_dir" | grep '\.conf$' | sed 's/\.conf$//')
            selected_theme=$(echo "$themes" | wofi -dmenu -p "Kitty Theme" -i) || return 0
            if [[ -n "$selected_theme" ]]; then
                sed -i "/^include themes\//d" "$CONFIG_DIR/kitty/kitty.conf"
                echo "include themes/$selected_theme.conf" >> "$CONFIG_DIR/kitty/kitty.conf"
                pkill -USR1 kitty || true
                notify "Settings" "Kitty theme set to $selected_theme"
            fi
            ;;
        "GTK Settings"*)
            command -v nwg-look &>/dev/null && nwg-look || notify "Settings" "Install nwg-look first"
            ;;
        "QT Apps Settings (qt6ct)"*)
            command -v qt6ct &>/dev/null && qt6ct || notify "Settings" "Install qt6ct first"
            ;;
        "QT Apps Settings (qt5ct)"*)
            command -v qt5ct &>/dev/null && qt5ct || notify "Settings" "Install qt5ct first"
            ;;
        "Switch Dark-Light Theme"*)
            local gtk_dark="Adwaita-dark" gtk_light="Adwaita"
            if [[ "$gtk_mode" == "'prefer-dark'" ]]; then
                gsettings set org.gnome.desktop.interface gtk-theme "$gtk_light"
                gsettings set org.gnome.desktop.interface color-scheme 'prefer-light'
                sed -i "s/^theme = .*/theme = $gtk_light/" "$CONFIG_DIR/qt5ct/qt5ct.conf" 2>/dev/null || true
                sed -i "s/^theme = .*/theme = $gtk_light/" "$CONFIG_DIR/qt6ct/qt6ct.conf" 2>/dev/null || true
                notify "Settings" "Switched to light mode"
            else
                gsettings set org.gnome.desktop.interface gtk-theme "$gtk_dark"
                gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
                sed -i "s/^theme = .*/theme = $gtk_dark/" "$CONFIG_DIR/qt5ct/qt5ct.conf" 2>/dev/null || true
                sed -i "s/^theme = .*/theme = $gtk_dark/" "$CONFIG_DIR/qt6ct/qt6ct.conf" 2>/dev/null || true
                notify "Settings" "Switched to dark mode"
            fi
            _reload_config
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# THEME UPDATE MODULE
# ═══════════════════════════════════════════════════════════════════════════════

accent_menu() {
    local current choice custom
    current=$(/usr/libexec/hyprbazzite-accent mode)
    choice=$(printf '%s\n' "Dracula purple" "Follow wallpaper" "Custom colour..." \
        | wofi -dmenu -p "Accent (now: $current)" -i) || return 0
    case "$choice" in
        "Dracula purple")   /usr/libexec/hyprbazzite-accent mode dracula >/dev/null ;;
        "Follow wallpaper") /usr/libexec/hyprbazzite-accent mode auto >/dev/null ;;
        "Custom colour...")
            custom=$(echo "" | wofi -dmenu -p "Hex colour, e.g. #ff79c6") || return 0
            [[ -n "$custom" ]] || return 0
            /usr/libexec/hyprbazzite-accent mode "$custom" >/dev/null \
                || { notify "Accent" "Invalid colour: $custom" "critical"; return 1; } ;;
        *) return 0 ;;
    esac
    notify "Accent" "Now $(/usr/libexec/hyprbazzite-accent hex)"
}

theme_update() {
    local wallpaper="${1:-$CONFIG_DIR/hypr/wallust/current_wallpaper.jpg}"

    if ! command -v wallust &>/dev/null; then
        # No wallust on this image: the wallpaper-driven part is the accent
        if /usr/libexec/hyprbazzite-accent apply >/dev/null; then
            notify "Theme" "Accent refreshed ($(/usr/libexec/hyprbazzite-accent hex))"
        else
            notify "Theme" "Accent refresh failed" "critical"
        fi
        return
    fi
    if [[ ! -f "$wallpaper" ]]; then
        notify "Theme" "Wallpaper not found: $wallpaper" "critical"
        return 1
    fi

    wallust run "$wallpaper"

    # Reload running services
    pgrep -x waybar >/dev/null && killall -SIGUSR2 waybar || true
    swaync-client -rs >/dev/null 2>&1 || true
    _reload_config 2>/dev/null || true

    notify "Theme" "Updated from $(basename "$wallpaper")"
}

# ═══════════════════════════════════════════════════════════════════════════════
# TDP MODULE
# ═══════════════════════════════════════════════════════════════════════════════

_is_amd_cpu() { grep -q AuthenticAMD /proc/cpuinfo 2>/dev/null; }

# First hwmon power cap. A glob, not `find /sys/class/hwmon/hwmon*`: those
# entries are symlinks, and find doesn't descend into symlinked start points.
_tdp_cap_file() {
    local f
    for f in /sys/class/hwmon/hwmon*/power1_cap; do
        [[ -e "$f" ]] && { echo "$f"; return 0; }
    done
    return 1
}

tdp_get_backend() {
    # ryzenadj/amdctl only drive AMD's SMU, and the Bazzite base ships
    # ryzenadj on every image, so Intel machines used to pick it too.
    if _is_amd_cpu; then
        if command -v ryzenadj >/dev/null 2>&1; then echo "ryzenadj"; return 0; fi
        if command -v amdctl >/dev/null 2>&1; then echo "amdctl"; return 0; fi
    fi
    if _tdp_cap_file >/dev/null; then echo "sysfs"; return 0; fi
    return 1
}

# $1 = "privileged": read through pkexec (wheel only, so it never prompts).
# Only for interactive callers - the waybar module polls every 30s.
tdp_get_current() {
    local backend run=()
    [[ "${1:-}" == privileged ]] && id -nG | grep -qw wheel && run=(pkexec)
    backend=$(tdp_get_backend || echo "unknown")
    case "$backend" in
        ryzenadj) "${run[@]}" ryzenadj --info | grep -E 'TDP|CPU Name' ;;
        amdctl) "${run[@]}" amdctl info | grep -i 'power limit\|cpu model' ;;
        sysfs) echo "Current TDP: $(( $(< "$(_tdp_cap_file)") / 1000000 ))W" ;;
        *) echo "TDP control unsupported" ;;
    esac
}

# pkexec, not sudo: this runs from waybar/wofi, where there is no terminal
# for sudo to prompt on, so it used to fail silently. 10-tdp-control.rules
# lets wheel users in an active local session run ryzenadj/amdctl without a
# password; anything else gets a normal polkit prompt.
tdp_set() {
    local watts="${1:-}" backend
    [[ "$watts" =~ ^[0-9]+$ ]] || { echo "Usage: hyprbazzite-ctl tdp set <watts>" >&2; return 1; }
    backend=$(tdp_get_backend) || { notify "Error" "TDP backend not found"; return 1; }

    case "$backend" in
        ryzenadj) pkexec ryzenadj --stapm-limit=$((watts*1000)) --fast-limit=$((watts*1000)) --slow-limit=$((watts*1000)) ;;
        amdctl) pkexec amdctl set power-limit "$watts" ;;
        sysfs) echo $((watts * 1000000)) | pkexec tee "$(_tdp_cap_file)" >/dev/null ;;
    esac || { notify "TDP" "Could not set ${watts}W via $backend" "critical"; return 1; }
    notify "TDP" "Set to ${watts}W via $backend"
}

tdp_menu() {
    local current
    current=$(tdp_get_current privileged | grep -o '[0-9]\+' | head -n1 || echo "unknown")
    local options="10W\n15W\n25W\n35W\n45W"
    local choice
    choice=$(echo -e "$options" | wofi --dmenu --width 300 --height 400 --prompt "Set TDP (Current: ${current}W)") || return 0
    if [[ -n "$choice" ]]; then
        local watts
        watts=$(echo "$choice" | grep -o '[0-9]\+')
        tdp_set "$watts"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# OSK MODULE
# ═══════════════════════════════════════════════════════════════════════════════

osk_toggle() {
    local bin="wvkbd"
    command -v wvkbd-mobintl >/dev/null 2>&1 && bin="wvkbd-mobintl"
    if pgrep -x "$bin" >/dev/null 2>&1; then
        pkill -x "$bin"
        notify "Keyboard" "OSK hidden"
    else
        "$bin" --hidden -H 420 -L 320 >/dev/null 2>&1 &
        sleep 0.2
        pkill -USR2 -x "$bin" >/dev/null 2>&1 || true
        notify "Keyboard" "OSK shown"
    fi
}

osk_swap_anchor() {
    local state_file="${XDG_RUNTIME_DIR:-/tmp}/wvkbd-anchor"
    local current="bottom"
    [[ -f "$state_file" ]] && current=$(cat "$state_file" 2>/dev/null || echo "bottom")

    local next="top"
    [[ "$current" = "top" ]] && next="bottom"

    printf '%s\n' "$next" > "$state_file"

    if command -v hyprctl >/dev/null 2>&1; then
        if [[ "$next" = "top" ]]; then
            hyprctl eval 'hl.window_rule({ match = { class = "^(wvkbd|wvkbd-.*)$" }, move = {"0","0"} })' >/dev/null 2>&1 || true
        else
            hyprctl eval 'hl.window_rule({ match = { class = "^(wvkbd|wvkbd-.*)$" }, move = {"0","50%"} })' >/dev/null 2>&1 || true
        fi
    fi

    if pgrep -x wvkbd-mobintl >/dev/null 2>&1 || pgrep -x wvkbd >/dev/null 2>&1; then
        pkill -x wvkbd-mobintl >/dev/null 2>&1 || true
        pkill -x wvkbd >/dev/null 2>&1 || true
        sleep 0.15
        osk_toggle
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# POWER MODULE
# ═══════════════════════════════════════════════════════════════════════════════

power_menu() {
    # "Sleep", not "Hybrid Sleep": this invokes _sleep_best_effort (systemd's
    # SleepOperation= fallback chain), which isn't actually systemd's
    # distinct "hybrid-sleep" mode (write the hibernation image immediately
    # while also suspending) - that mismatch predates this menu's current
    # behavior too, it was never literally hybrid-sleep under the hood.
    local options="⏻ Shutdown\n Reboot\n Suspend\n⏾ Sleep\n Lock\n Logout"
    local choice
    choice=$(echo -e "$options" | wofi --dmenu --width 300 --height 400 --prompt "Power") || return 0
    case "$choice" in
        *"Shutdown"*) power_action shutdown ;;
        *"Reboot"*) power_action reboot ;;
        *"Suspend"*) power_action suspend ;;
        *"Sleep"*) power_action sleep ;;
        *"Lock"*) power_action lock ;;
        *"Logout"*) power_action logout ;;
    esac
}

# Lock through logind so hypridle's lock_cmd runs: one hyprlock instance, with
# the image's config. A bare `hyprlock` finds no config at all (it searches
# ~/.config/hypr and /etc/xdg/hypr, never /etc/hypr) and exits without
# locking. lock-session does nothing if hypridle isn't running, so start
# hyprlock directly in that case.
_lock_now() {
    if pgrep -x hypridle >/dev/null 2>&1; then
        loginctl lock-session
    else
        pidof hyprlock >/dev/null 2>&1 || hyprlock -c /etc/hypr/hyprlock.conf
    fi
}

power_action() {
    local action="$1"
    case "$action" in
        shutdown) systemctl poweroff ;;
        reboot) systemctl reboot ;;
        suspend) systemctl suspend ;;
        sleep) _sleep_best_effort ;;
        lock) _lock_now ;;
        logout) hyprctl eval 'hl.dispatch(hl.dsp.exit())' ;;
        *) echo "Unknown power action: $action"; return 1 ;;
    esac
}

power_profile_cycle() {
    local current
    current=$(busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | awk -F'"' '{print $2}')
    local next
    case "$current" in
        power-saver) next='balanced' ;;
        balanced) next='performance' ;;
        performance) next='power-saver' ;;
        *) next='balanced' ;;
    esac
    if busctl --system set-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile s "$next" >/dev/null 2>&1; then
        notify "Power Profile" "Switched to ${next}"
    elif command -v tuned-adm >/dev/null 2>&1 && sudo -n tuned-adm profile balanced >/dev/null 2>&1; then
        notify "Power Profile" "Switched to balanced via tuned-adm"
    else
        notify "Error" "Could not switch power profile" "critical"
    fi
    # Signal waybar to refresh
    pkill -RTMIN+8 waybar 2>/dev/null || true
}

# ═══════════════════════════════════════════════════════════════════════════════
# AUTOMATION MODULE (waybar exec helpers & background services)
# ═══════════════════════════════════════════════════════════════════════════════

# Hyprland's event socket: newer releases keep it under $XDG_RUNTIME_DIR/hypr,
# older ones under /tmp/hypr. The DND/monitor automation only knew the latter,
# so on this Hyprland it could never connect.
_hypr_socket2() {
    local sig="${HYPRLAND_INSTANCE_SIGNATURE:-}" d
    [[ -n "$sig" ]] || return 1
    for d in "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" /tmp/hypr; do
        [[ -S "$d/$sig/.socket2.sock" ]] && { echo "$d/$sig/.socket2.sock"; return 0; }
    done
    return 1
}

automation_dnd() {
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
        echo "Hyprland instance signature not found." >&2
        return 1
    fi
    local sock
    sock=$(_hypr_socket2) || { echo "Hyprland event socket not found." >&2; return 1; }
    socat -U - "UNIX-CONNECT:$sock" | while read -r line; do
        case "$line" in
            fullscreen\>\>1) swaync-client --dnd-on ;;
            fullscreen\>\>0) swaync-client --dnd-off ;;
            monitoradded\>\>*) workspace_reflow_soon ;;
            monitorremoved\>\>*)
                workspace_reflow_soon
                # Unplugging the last external display while the lid is
                # closed should sleep the machine, same as closing the lid
                # undocked (mirrors macOS clamshell behavior). logind's own
                # HandleLidSwitchDocked=ignore only gets evaluated at the
                # physical switch event, so it won't react to this on its
                # own. lid_sync recomputes external_count itself, so this is
                # a no-op if another external display is still connected;
                # the _lid_is_closed guard just skips the hyprctl/jq work
                # entirely while the lid's open.
                _lid_is_closed && lid_sync
                ;;
        esac
    done
}

automation_osk() {
    local conf="/etc/hypr/wvkbd.conf"
    [[ -f "$conf" ]] && . "$conf"
    local layout="${WVKBD_LAYOUT:-mobintl}"
    local font="${WVKBD_FONT:-JetBrains Mono 20}"
    local bg="${WVKBD_BG:-282a36}" fg="${WVKBD_FG:-44475a}"
    local fg_sp="${WVKBD_FG_SP:-bd93f9}" press="${WVKBD_PRESS:-6272a4}"
    local press_sp="${WVKBD_PRESS_SP:-ff79c6}" text="${WVKBD_TEXT:-f8f8f2}"
    local text_sp="${WVKBD_TEXT_SP:-f8f8f2}" alpha="${WVKBD_ALPHA:-230}"
    local height="${WVKBD_HEIGHT:-420}" height_land="${WVKBD_HEIGHT_LANDSCAPE:-320}"
    local layers="${WVKBD_LAYERS:-fullwide,special,emoji,nav}"
    local land_layers="${WVKBD_LANDSCAPE_LAYERS:-landscape,landscapespecial,emoji,nav}"
    local anchor="${WVKBD_ANCHOR:-bottom}"
    local state_file="${XDG_RUNTIME_DIR:-/tmp}/wvkbd-anchor"
    [[ -f "$state_file" ]] && anchor=$(cat "$state_file" 2>/dev/null || echo "$anchor")

    local bin=""
    command -v wvkbd-mobintl >/dev/null 2>&1 && bin="wvkbd-mobintl" || \
        (command -v wvkbd >/dev/null 2>&1 && bin="wvkbd") || return 0

    _sync_state() {
        if compgen -G "/dev/input/by-id/*-event-kbd" >/dev/null; then
            pkill -x "$bin" >/dev/null 2>&1 || true
        else
            if ! pgrep -x "$bin" >/dev/null 2>&1; then
                "$bin" --hidden -H "$height" -L "$height_land" -l "$layers" \
                    --landscape-layers "$land_layers" --fn "$font" --alpha "$alpha" \
                    --bg "$bg" --fg "$fg" --fg-sp "$fg_sp" --press "$press" \
                    --press-sp "$press_sp" --text "$text" --text-sp "$text_sp" >/dev/null 2>&1 &
            fi
        fi
    }

    _sync_state
    if [[ "$anchor" = "top" ]]; then
        hyprctl eval 'hl.window_rule({ match = { class = "^(wvkbd|wvkbd-.*)$" }, float = true, move = {"0","0"} })' >/dev/null 2>&1 || true
    else
        hyprctl eval 'hl.window_rule({ match = { class = "^(wvkbd|wvkbd-.*)$" }, float = true, move = {"0","50%"} })' >/dev/null 2>&1 || true
    fi
    udevadm monitor --udev --subsystem-match=input --property | while read -r line; do
        [[ "$line" =~ ACTION=(add|remove|change) ]] && _sync_state
    done
}

automation_temp() {
    # Polled by waybar every 10s, so no forks per sensor: builtin reads, the
    # score set in a variable rather than echoed through a subshell, and
    # hwmon scored once per device (the score only depends on its name).
    local best_temp_mc="" best_source="" best_score=-1 score
    _score() {
        local src_lc=${1,,}
        if [[ "$src_lc" =~ (tctl|cpu|package|x86_pkg_temp|coretemp|k10temp|zenpower|soc_thermal) ]]; then score=300
        elif [[ "$src_lc" =~ acpitz ]]; then score=180
        elif [[ "$src_lc" =~ (junction|edge|amdgpu|gpu) ]]; then score=120
        elif [[ "$src_lc" =~ (nvme|ssd) ]]; then score=90
        else score=60; fi
    }
    local zone temp_mc type
    for zone in /sys/class/thermal/thermal_zone*; do
        [[ -r "$zone/temp" ]] || continue
        { read -r temp_mc < "$zone/temp"; } 2>/dev/null || continue
        { read -r type < "$zone/type"; } 2>/dev/null || type="unknown"
        _score "$type"
        (( score > best_score )) && { best_score=$score; best_temp_mc=$temp_mc; best_source="thermal:${type}"; }
    done
    local hw name input label
    for hw in /sys/class/hwmon/hwmon*; do
        [[ -d "$hw" ]] || continue
        { read -r name < "$hw/name"; } 2>/dev/null || name="unknown"
        _score "$name"
        (( score > best_score )) || continue
        # First readable input of the best-scoring device, as before.
        for input in "$hw"/temp*_input; do
            [[ -r "$input" ]] || continue
            { read -r temp_mc < "$input"; } 2>/dev/null || continue
            { read -r label < "${input%_input}_label"; } 2>/dev/null || label="temp"
            best_score=$score; best_temp_mc=$temp_mc; best_source="${name}:${label}"
            break
        done
    done

    local text tooltip class
    if [[ -z "$best_temp_mc" ]]; then
        text="N/A 󰔏"; tooltip="Unavailable"; class="missing"
    else
        local temp_c=$((best_temp_mc / 1000))
        local icon="󰈸"; class="cool"
        (( temp_c >= 70 )) && { icon="󰔄"; class="warm"; }
        (( temp_c >= 85 )) && { icon="󰸁"; class="hot"; }
        text="${temp_c}°C ${icon}"; tooltip="Sensor: $best_source"
    fi
    printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' "$(json_escape "$text")" "$(json_escape "$tooltip")" "$class"
}

# ═══════════════════════════════════════════════════════════════════════════════
# WAYBAR EXEC MODULES (JSON output for waybar custom modules)
# ═══════════════════════════════════════════════════════════════════════════════

waybar_power_status() {
    local backend="unknown" profile="unknown"

    local out
    if out=$(busctl --system get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null); then
        backend="tuned-ppd"
        profile=${out#s \"}; profile=${profile%\"}   # s "balanced" -> balanced
    elif command -v tuned-adm >/dev/null 2>&1; then
        backend="tuned"
        profile=$(tuned-adm active 2>/dev/null | sed -n 's/^Current active profile: *//p')
    fi

    # Nerd Font (Material Design) glyphs, spelled as escapes so they can't be
    # silently stripped from the file: rocket / gauge / leaf.
    local icon
    case "$profile" in
        throughput-performance*|latency-performance*|performance*) icon=$'\U000F14DE' ;;
        balanced*) icon=$'\U000F0787' ;;
        powersave*|power-saver*) icon=$'\U000F032A' ;;
        *) icon=$'\U000F02DC' ;;   # help-circle
    esac

    local tdp="unavailable" tdp_supported=0
    local current_tdp
    current_tdp=$(tdp_get_current 2>/dev/null | grep -o '[0-9]\+' | head -n1 || true)
    if [[ -n "${current_tdp:-}" ]] && [[ "$current_tdp" =~ ^[0-9]+$ ]]; then
        tdp="${current_tdp}W"
        tdp_supported=1
    fi

    local text tooltip
    if [[ "$tdp_supported" -eq 1 ]]; then
        printf -v tooltip 'Power profile: %s\nCurrent TDP: %s\nBackend: %s\n\nLeft click: Cycle profile\nRight click: Open TDP selector' "${profile:-unknown}" "$tdp" "$backend"
        text="${tdp} ${icon}"
    else
        printf -v tooltip 'Power profile: %s\nBackend: %s\n\nLeft click: Cycle profile' "${profile:-unknown}" "$backend"
        text="${icon}"
    fi

    printf '{"text":"%s ","tooltip":"%s","class":"%s","alt":"%s"}\n' \
        "$(json_escape "$text")" "$(json_escape "$tooltip")" \
        "$(json_escape "${profile:-unknown}")" "$(json_escape "${profile:-unknown}")"
}

waybar_headset_battery() {
    local bin="/usr/bin/headsetcontrol"
    if ! command -v "$bin" &>/dev/null; then
        echo ""; return 0
    fi
    local out
    out=$("$bin" -b 2>/dev/null) || { echo ""; return 0; }
    local low_out
    low_out=$(printf "%s" "$out" | tr '[:upper:]' '[:lower:]')

    if printf "%s" "$low_out" | grep -E -q "not found|no headset|not connected|disconnected|power: *off|state: *off|status: *off"; then
        printf "%s\n" "-1"; return 0
    fi

    local level_field
    level_field=$(printf "%s" "$out" | awk -F'Level:' '/Level:/ {print $2; exit}' | tr -d ' \t')
    [[ -z "$level_field" ]] && { echo ""; return 0; }

    local pct_signed
    pct_signed=$(printf "%s" "$level_field" | sed -n 's/^\([+-]\?[0-9]\+\).*/\1/p')
    [[ -z "$pct_signed" || "$pct_signed" =~ ^- ]] && { echo ""; return 0; }

    printf "%s\n" "${pct_signed#+}"
}

_sleep_best_effort() {
    # `systemctl sleep`, not `systemctl suspend-then-hibernate` directly:
    # the latter needs real kernel hibernation support, which varies a lot
    # across hardware and isn't guaranteed - confirmed live on this very
    # machine, CanSuspendThenHibernate/CanHibernate both report "na" (not
    # "no" - genuinely unavailable, not just policy-disabled), because
    # Secure Boot puts the kernel in lockdown=integrity mode, which disables
    # hibernation outright (/sys/power/state has no "disk" entry at all
    # here). `systemctl sleep` instead defers to logind's own
    # SleepOperation= chain (logind.conf(5), systemd 256+ - this image ships
    # 259): it tries suspend-then-hibernate, then suspend, then hibernate,
    # using the first one the hardware actually supports - so this always
    # actually sleeps instead of silently doing nothing, the single worst
    # possible outcome for "closed lid in a bag", which is the entire point
    # of this call existing. Shared by the lid module and the power menu's
    # Sleep action.
    systemctl sleep
}

# ═══════════════════════════════════════════════════════════════════════════════
# LID MODULE
# ═══════════════════════════════════════════════════════════════════════════════

_lid_is_closed() {
    # Defer to logind's own LidClosed property instead of parsing
    # /proc/acpi/button/lid ourselves - logind already has to get this
    # exactly right for its own HandleLidSwitch sleep decision to work (it
    # has been correct the whole time), so asking it directly is one fewer
    # place to parse raw ACPI state wrong, not two. This is the exact same
    # property hyprbazzite-lid.service already keys its trigger off of, so
    # the trigger and the decision now read from a single authoritative
    # source instead of two separate, independently-maintained parsers -
    # which is exactly the class of bug that made this not work at all
    # until today (a one-character maxdepth mistake in the old hand-rolled
    # ACPI parser). No root needed for this property read - confirmed live.
    local closed
    closed=$(busctl --system get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager LidClosed 2>/dev/null)
    [[ "$closed" == "b true" ]]
}

lid_sync() {
    # Single source of truth for lid-driven state - called from every
    # trigger point (physical switch close/open, a dock/undock while already
    # closed, session startup, post-resume) instead of three separate
    # actions that each hardcoded assumptions about *why* they were called.
    # This just looks at the real physical state and converges to the
    # correct outcome, so it's safe and idempotent to call from anywhere,
    # any number of times, for any reason.
    #
    # logind (HandleLidSwitch=sleep undocked, HandleLidSwitchDocked=ignore
    # docked - see the logind.conf.d drop-in)
    # already decides suspend-vs-stay-awake for the *physical* lid switch in
    # parallel with this, independently. All this needs to do is the
    # cosmetic clamshell action logind has no concept of (blank/restore the
    # internal panel), plus catch the cases logind's own docked check never
    # gets evaluated for at all: a dock/undock, a resume, or a session start
    # that all happen while the lid is already closed.
    #
    # "all" is required here, not just the default active-monitor list: once
    # the internal panel is disabled it drops out of the default list, so a
    # later call would see no internal output at all and misread a
    # still-docked laptop as a desktop with no lid.
    local internal_output
    internal_output=$(hyprctl -j monitors all 2>/dev/null | jq -r '.[] | select(.name | test("^(eDP|LVDS)")) | .name' | head -n1)
    [[ -z "$internal_output" ]] && return 0  # desktop-only setup, nothing to do

    local external_count
    # Enabled, real externals only: a disabled one is no dock (counting it would blank
    # the panel on a laptop left with no display), and Hyprland's own FALLBACK
    # output - which appears the moment the last real display goes away - is not one
    # either, or unplugging the dock with the lid closed would never sleep.
    external_count=$(hyprctl -j monitors all 2>/dev/null | jq '[.[] | select((.name | test("^(eDP|LVDS|FALLBACK)") | not) and (.disabled | not))] | length')

    # `hyprctl keyword`/`hyprctl dispatch` error on this build (native Lua
    # config engine, "non-legacy parser") - `hyprctl eval` is the working
    # equivalent used throughout this script.
    if _lid_is_closed; then
        if [[ "$external_count" -gt 0 ]]; then
            hyprctl eval "hl.monitor({ output = '$internal_output', disabled = true })"
            # Panel is out of the workspace plan now: move its workspaces (and
            # windows) onto the external displays.
            sleep 1; workspace_rebind reflow
        else
            loginctl lock-session 2>/dev/null || true
            # Prefers suspend-then-hibernate over plain suspend: a laptop
            # left closed long enough (packed in a bag for travel) ideally
            # falls back to a real hibernate instead of slowly draining the
            # battery in RAM-suspend the whole time - but only where the
            # hardware actually supports it (_sleep_best_effort checks
            # first and falls back to plain suspend otherwise, so this
            # always actually sleeps either way).
            _sleep_best_effort
        fi
    else
        # Re-enable the panel and power it on together, in order, in the one
        # resume handler that knows this output was just re-enabled.
        # hypridle's own after_sleep_cmd also sends dpms "on" from a separate
        # trigger with no ordering guarantee against this one, but both now
        # pass an explicit { action = 'on' }, which is idempotent, so the
        # order no longer matters. (The old "screen stays black on the first
        # open after sleep, fixes itself on the second" symptom was blamed on
        # that race, but the real cause was dpms(true) being a TOGGLE on this
        # build: two "on" calls from two triggers cancelled each other out.)
        hyprctl eval "hl.monitor({ output = '$internal_output', disabled = false }); hl.dispatch(hl.dsp.dpms({ action = 'on' }))"
        # ...and hand them back to the panel once it is enabled again.
        sleep 1; workspace_rebind reflow
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# WORKSPACE MODULE
# ═══════════════════════════════════════════════════════════════════════════════

# Monitors get workspaces five at a time, in order: the first monitor 1-5, the
# second 6-10, a third 11-15 (reachable by scrolling). Order is either
#   position (default) left to right, then top to bottom within a column
#   internal           laptop panel first, then external displays by position
# Reads `hyprctl -j monitors all` JSON on stdin, prints "<name> <first workspace>
# <disabled 0|1>" per monitor. Disabled monitors are left out: with the lid closed
# (laptop panel off) the external displays take over its workspaces, and opening
# the lid hands them back - like macOS/AeroSpace clamshell.
_workspace_plan() {
    local mode="${1:-position}"
    jq -r --arg mode "$mode" '
        def internal: .name | test("^(eDP|LVDS|DSI)");
        def bypos: sort_by([.x, .y, .name]);
        [.[] | select(.disabled | not)]
        | (if $mode == "internal"
            then ([.[] | select(internal)] | bypos) + ([.[] | select(internal | not)] | bypos)
            else bypos end)
        | to_entries[] | "\(.value.name) \(.key * 5 + 1) \(if .value.disabled then 1 else 0 end)"'
}

workspace_layout_get() {
    local f="${XDG_CONFIG_HOME:-$HOME/.config}/hyprbazzite/workspace-layout" m=""
    [[ -r "$f" ]] && m=$(head -n1 "$f" | tr -d '[:space:]')
    case "$m" in internal) echo internal ;; *) echo position ;; esac
}

workspace_layout_menu() {
    local current choice
    current=$(workspace_layout_get)
    choice=$(printf '%s\n' "By position (left to right)" "Laptop screen first (1-5)" \
        | wofi -dmenu -p "Workspaces (now: $current)" -i) || return 0
    case "$choice" in
        "By position"*)  workspace_layout_set position ;;
        "Laptop screen"*) workspace_layout_set internal ;;
        *) return 0 ;;
    esac
    notify "Workspaces" "Layout: $(workspace_layout_get)"
}

workspace_layout_set() {
    local m="${1:-}" dir="${XDG_CONFIG_HOME:-$HOME/.config}/hyprbazzite"
    case "$m" in
        position|internal) ;;
        "") workspace_layout_get; return 0 ;;
        *) echo "Usage: hyprbazzite-ctl workspace layout [position|internal]" >&2; return 1 ;;
    esac
    mkdir -p "$dir" && echo "$m" >"$dir/workspace-layout"
    workspace_rebind init
}

# i3/AeroSpace-style: SUPER+1..5 always land on the first monitor, SUPER+6..10 on
# the second, regardless of which monitor has focus (see _workspace_plan for the
# ordering). Run with "init" at session start / layout change to also put each
# monitor on its own first workspace - Hyprland creates default workspaces 1 and
# 2 before this runs, and a workspace rule never moves a workspace that exists.
workspace_rebind() {
    local init=0 reflow=0
    case "${1:-}" in init) init=1 ;; reflow) reflow=1 ;; esac

    local plan count
    plan=$(hyprctl -j monitors all 2>/dev/null | _workspace_plan "$(workspace_layout_get)")
    [[ -z "$plan" ]] && return 0
    count=$(wc -l <<<"$plan")

    local first_name
    first_name=$(head -n1 <<<"$plan" | cut -d' ' -f1)

    # Emits the workspace rules; $1 = extra rule field (", persistent = true" etc.)
    _ws_rules() {
        local name first i suffix expr=""
        while read -r name first _; do
            for i in 1 2 3 4 5; do
                suffix="$1"
                if [[ $i -eq 1 ]]; then suffix+=", default = true"; fi
                expr+="hl.workspace_rule({ workspace = '$((first + i - 1))', monitor = '$name'$suffix }); "
            done
        done <<<"$plan"
        # Fewer than 2 monitors: the "missing" 6-10 stay reachable on the first one.
        if (( count < 2 )); then
            for i in 6 7 8 9 10; do
                expr+="hl.workspace_rule({ workspace = '$i', monitor = '$first_name'$1 }); "
            done
        fi
        echo "$expr"
    }

    if (( init || reflow )); then
        # A persistent rule is what actually relocates an existing workspace
        # (a plain rule only applies when a workspace is created, and Hyprland
        # has already made defaults 1 and 2 by now). Pin everything, pick each
        # monitor's workspace, then release so empty ones clean up normally.
        local focused name first disabled expr=""
        local prev_visible with_windows
        focused=$(hyprctl -j monitors 2>/dev/null | jq -r '[.[] | select(.focused)][0].name // empty')
        prev_visible=$(hyprctl -j monitors 2>/dev/null | jq -c '[.[].activeWorkspace.id]')
        with_windows=$(hyprctl -j workspaces 2>/dev/null | jq -c '[.[] | select(.windows > 0) | .id]')
        [[ -n "$prev_visible" ]] || prev_visible='[]'
        [[ -n "$with_windows" ]] || with_windows='[]'
        hyprctl eval "$(_ws_rules ", persistent = true")" >/dev/null 2>&1
        if (( init )); then
            # Last monitor first, so focus ends on the first monitor's first workspace.
            # Disabled monitors (lid closed) are skipped: focusing a workspace that
            # belongs to one would pull focus onto whichever display is left.
            while read -r name first disabled; do
                [[ "$disabled" == 1 ]] && continue
                expr+="hl.dispatch(hl.dsp.focus({ workspace = $first })); "
            done < <(tac <<<"$plan")
        else
            # Hotplug reflow: show on each monitor, from its own range, a workspace
            # that was on screen and has windows, else any with windows, else one that
            # was on screen (Hyprland's fresh empty default on a new monitor counts
            # for least), else its first - then put focus back where it was.
            local pick span=5
            # A lone monitor owns every workspace (1-10), not just its own five.
            (( count < 2 )) && span=10
            while read -r name first disabled; do
                [[ "$disabled" == 1 ]] && continue
                pick=$(jq -n -r --argjson first "$first" --argjson span "$span" --argjson prev "$prev_visible" --argjson win "$with_windows" '
                    [range($first; $first + $span)] as $r
                    | [$r[] | select(. as $x | $prev | index($x))] as $vis
                    | [$r[] | select(. as $x | $win | index($x))] as $occ
                    | ([$vis[] | select(. as $x | $occ | index($x))] | first)
                      // ($occ | first) // ($vis | first) // $first')
                expr+="hl.dispatch(hl.dsp.focus({ workspace = $pick })); "
            done < <(tac <<<"$plan")
            if [[ -n "$focused" ]] && grep -q "^$focused " <<<"$plan"; then
                expr+="hl.dispatch(hl.dsp.focus({ monitor = '$focused' })); "
            fi
        fi
        [[ -n "$expr" ]] && hyprctl eval "$expr" >/dev/null 2>&1
        hyprctl eval "$(_ws_rules ", persistent = false")" >/dev/null 2>&1
    else
        hyprctl eval "$(_ws_rules "")" >/dev/null 2>&1
    fi
}

# Monitor hotplug: events arrive in bursts (one per output, plus wake-from-sleep
# reprobes), so wait for them to settle, then reflow once.
workspace_reflow_soon() {
    local gen="$RANDOM$RANDOM" f="${XDG_RUNTIME_DIR:-/tmp}/hyprbazzite-ws-gen"
    echo "$gen" >"$f"
    (
        sleep 1.5
        [[ "$(cat "$f" 2>/dev/null)" == "$gen" ]] && workspace_rebind reflow
    ) &
}

# ═══════════════════════════════════════════════════════════════════════════════
# KEYBINDS MODULE
# ═══════════════════════════════════════════════════════════════════════════════

keybinds_switch() {
    local action="${1:-}"
    # Profiles are pure Hyprland binds — no keyd, no external remapper. bindings.lua
    # picks macOS when this marker exists, else Linux. The marker lives in the
    # per-user state dir, so toggling is user-writable, needs no root, and
    # survives reboot/logout.
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
    local marker="$state_dir/hyprbazzite-keybinds-macos"
    local current="linux"
    [[ -e "$marker" ]] && current="macos"

    _apply() {
        case "$1" in
            macos) mkdir -p "$state_dir" && : > "$marker" ;;
            linux) rm -f "$marker" ;;
        esac
        notify "Keybinds" "Switched to ${1} profile. Reloading..."
        _reload_config
    }

    case "$action" in
        macos|linux) _apply "$action" ;;
        toggle)
            if [[ "$current" == "macos" ]]; then _apply linux; else _apply macos; fi
            ;;
        status|"")   echo "Current keybind profile: $current" ;;
        *)
            echo "Usage: hyprbazzite-ctl keybinds [macos|linux|toggle|status]"
            return 1
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# OPEN MODULE — native XDG launcher for common app classes
#
# Common apps are launched purely through XDG resolution so they always point at
# whatever the user installed/chose — nothing is hardcoded.
#   * Targets (files/dirs/urls) go straight through `xdg-open`, which honours the
#     mimeapps.list defaults, then falls back to the mimeinfo.cache registry that
#     `update-desktop-database` builds from each installed app's `MimeType=`.
#   * "Launch browser" has no target, so we resolve the handler for
#     x-scheme-handler/https. If no default is configured we autodetect the first
#     installed registrant, persist it as the default (so GUI settings agree), then
#     launch it. We only set a default when none was configured, so we never
#     override an explicit user choice.
# ═══════════════════════════════════════════════════════════════════════════════

# Every applications dir where .desktop files / mimeinfo caches live
# (system, per-user, and flatpak exports).
_xdg_app_dirs() {
    local d _dd=()
    IFS=: read -ra _dd <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${XDG_DATA_HOME:-$HOME/.local/share}" "${_dd[@]}" \
             /var/lib/flatpak/exports/share \
             "$HOME/.local/share/flatpak/exports/share"; do
        [[ -d "$d/applications" ]] && printf '%s\n' "$d/applications"
    done
}

# True if a desktop id (e.g. firefox.desktop) resolves to an installed file.
_desktop_installed() {
    local id="$1" dir
    [[ -z "$id" ]] && return 1
    while IFS= read -r dir; do
        [[ -f "$dir/$id" ]] && return 0
    done < <(_xdg_app_dirs)
    return 1
}

# First *installed* app registered as a handler for a mimetype/scheme, read from
# the native mimeinfo.cache registry.
_first_registrant() {
    local mimetype="$1" dir ids id _ids=()
    while IFS= read -r dir; do
        [[ -f "$dir/mimeinfo.cache" ]] || continue
        ids=$(grep -m1 "^${mimetype}=" "$dir/mimeinfo.cache" 2>/dev/null | cut -d= -f2-) || ids=""
        [[ -z "$ids" ]] && continue
        IFS=';' read -ra _ids <<< "$ids"
        for id in "${_ids[@]}"; do
            [[ -n "$id" ]] && _desktop_installed "$id" && { printf '%s\n' "$id"; return 0; }
        done
    done < <(_xdg_app_dirs)
    return 1
}

# Launch an installed desktop id, preferring gtk-launch, falling back to gio.
_launch_desktop() {
    local id="$1" dir
    if command -v gtk-launch >/dev/null 2>&1; then
        exec gtk-launch "${id%.desktop}"
    elif command -v gio >/dev/null 2>&1; then
        while IFS= read -r dir; do
            [[ -f "$dir/$id" ]] && exec gio launch "$dir/$id"
        done < <(_xdg_app_dirs)
    fi
    return 1
}

open_browser() {
    local id
    # 1) explicit default (user or system) — only if it's actually installed.
    id=$(xdg-settings get default-web-browser 2>/dev/null | head -n1) || id=""
    _desktop_installed "$id" || id=""
    # 2) otherwise autodetect the first installed https handler and remember it.
    if [[ -z "$id" ]]; then
        id=$(_first_registrant x-scheme-handler/https) || id=""
        [[ -n "$id" ]] && { xdg-settings set default-web-browser "$id" 2>/dev/null || true; }
    fi
    if [[ -z "$id" ]]; then
        notify "Browser" "No web browser installed yet — install one and it becomes the default automatically." "critical"
        return 1
    fi
    _launch_desktop "$id" || {
        notify "Browser" "Could not launch $id" "critical"; return 1
    }
}

open_target() {
    local target="${1:-$HOME}"
    if command -v xdg-open >/dev/null 2>&1; then
        exec xdg-open "$target"
    fi
    notify "Open" "xdg-open is not available" "critical"
    return 1
}

# "Awake" = an idle inhibitor held by a transient user unit. One source of
# truth shared by the swaync Awake toggle and the waybar idle indicator
# (custom/idle, signal 9). hypridle honours systemd idle inhibitors, so its
# idle lock/screen-off listeners pause while before_sleep_cmd still locks the
# screen before every suspend. Stopping hypridle instead (as this used to)
# also dropped that lock: closing the lid resumed to an unlocked desktop.
_AWAKE_UNIT="hyprbazzite-awake.service"

_awake_active() { systemctl --user is-active --quiet "$_AWAKE_UNIT"; }

_awake_apply() {
    if [[ "$1" == "on" ]]; then
        _awake_active || systemd-run --user --quiet --collect --unit="$_AWAKE_UNIT" \
            systemd-inhibit --what=idle --who=HyprBazzite --why="Awake mode" sleep infinity
    else
        systemctl --user stop "$_AWAKE_UNIT" 2>/dev/null || true
        pgrep -x hypridle >/dev/null 2>&1 || setsid hypridle -c /etc/hypr/hypridle.conf >/dev/null 2>&1 &
    fi
    sleep 0.2
    pkill -RTMIN+9 waybar 2>/dev/null || true
}

waybar_idle_status() {
    local awake=0 text class tip
    _awake_active && awake=1
    if (( awake )); then
        text=$'\U000F0208'; class="activated"; tip=$'Staying awake: idle lock and screen-off are paused\n(the screen still locks before sleep)\n\nClick: allow idle again'
    else
        text=$'\U000F0209'; class="deactivated"; tip=$'Idle lock/sleep enabled\n\nClick: stay awake'
    fi
    printf '{"text":"%s","tooltip":"%s","class":"%s","alt":"%s"}\n' \
        "$(json_escape "$text")" "$(json_escape "$tip")" "$class" "$class"
}

# ═══════════════════════════════════════════════════════════════════════════════
# WAYBAR FOCUSED-APP NAME
# ═══════════════════════════════════════════════════════════════════════════════
# Resolves the active window's class to its real application name from the
# .desktop files (so unknown apps need no hand-written rename list), falling
# back to a tidied class. Long-running: prints one JSON line per focus change.

declare -A _APPNAME_CACHE=()

_app_name_for_class() {
    local cls="$1" lc f name dirs d
    [[ -n "$cls" ]] || return 0
    [[ -n "${_APPNAME_CACHE[$cls]+x}" ]] && { echo "${_APPNAME_CACHE[$cls]}"; return 0; }
    lc=${cls,,}
    dirs=("$HOME/.local/share/applications" "/usr/share/applications"
          "/var/lib/flatpak/exports/share/applications"
          "$HOME/.local/share/flatpak/exports/share/applications")
    name=""
    for d in "${dirs[@]}"; do
        [[ -d "$d" ]] || continue
        for f in "$d/$cls.desktop" "$d/$lc.desktop"; do
            [[ -f "$f" ]] && { name=$(sed -n 's/^Name=//p' "$f" | head -n1); break 2; }
        done
    done
    if [[ -z "$name" ]]; then
        f=$(grep -il -m1 "^StartupWMClass=${cls}\$" "${dirs[@]/%//*.desktop}" 2>/dev/null | head -n1)
        [[ -n "$f" ]] && name=$(sed -n 's/^Name=//p' "$f" | head -n1)
    fi
    if [[ -z "$name" ]]; then
        name=${cls##*.}               # com.foo.Bar -> Bar
        name=${name//[-_]/ }
        name=${name^}                 # kitty -> Kitty
    fi
    _APPNAME_CACHE[$cls]="$name"
    echo "$name"
}

_emit_app_name() {
    local cls name
    cls=$(hyprctl -j activewindow 2>/dev/null | jq -r '.class // empty' 2>/dev/null)
    name=$(_app_name_for_class "$cls")
    printf '{"text":"%s","tooltip":"%s","class":"%s"}\n' \
        "$(json_escape "$name")" "$(json_escape "$cls")" "${name:+active}"
}

waybar_app_name() {
    _emit_app_name
    local sock
    sock=$(_hypr_socket2) || return 0
    socat -U - "UNIX-CONNECT:$sock" | while read -r line; do
        case "$line" in
            activewindow\>\>*|closewindow\>\>*|workspace\>\>*|focusedmon\>\>*) _emit_app_name ;;
        esac
    done
}

# ═══════════════════════════════════════════════════════════════════════════════
# SWAYNC QUICK-SETTINGS BUTTONS
# ═══════════════════════════════════════════════════════════════════════════════
# swaync's buttons-grid runs each command through its own parser, which mangles
# nested quotes/$(...) - so the logic lives here and the JSON just calls
#   qs <name> state   -> prints true|false (toggle's initial state)
#   qs <name> set     -> applies $SWAYNC_TOGGLE_STATE (true|false)
#   qs <name> run     -> one-shot action (panel closes first where it matters)

_qs_onoff() { [[ "${SWAYNC_TOGGLE_STATE:-}" == "true" ]] && echo "$1" || echo "$2"; }

qs() {
    local name="${1:-}" mode="${2:-run}"
    local sink='@DEFAULT_AUDIO_SINK@' src='@DEFAULT_AUDIO_SOURCE@'
    case "$name:$mode" in
        wifi:state)      [[ "$(nmcli radio wifi 2>/dev/null)" == "enabled" ]] && echo true || echo false ;;
        wifi:set)        nmcli radio wifi "$(_qs_onoff on off)" ;;
        bluetooth:state) bluetoothctl show 2>/dev/null | grep -q "Powered: yes" && echo true || echo false ;;
        bluetooth:set)   bluetoothctl power "$(_qs_onoff on off)" >/dev/null ;;
        speakers:state)  wpctl get-volume "$sink" 2>/dev/null | grep -q MUTED && echo true || echo false ;;
        speakers:set)    wpctl set-mute "$sink" "$(_qs_onoff 1 0)" ;;
        mic:state)       wpctl get-volume "$src" 2>/dev/null | grep -q MUTED && echo true || echo false ;;
        mic:set)         wpctl set-mute "$src" "$(_qs_onoff 1 0)" ;;
        awake:state)     _awake_active && echo true || echo false ;;
        awake:set)       _awake_apply "$(_qs_onoff on off)" ;;
        awake:toggle)    if _awake_active; then _awake_apply off; else _awake_apply on; fi ;;
        gamemode:state)  [[ "$(_animations_enabled)" == "0" ]] && echo true || echo false ;;
        gamemode:set)    gamemode_toggle ;;
        nightlight:state)
            hyprctl -j getoption decoration:screen_shader 2>/dev/null | jq -r '.str // ""' | grep -q "nightlight.frag" && echo true || echo false ;;
        nightlight:set)
            local shader="${HYPRBAZZITE_NIGHTLIGHT_SHADER:-/usr/lib/hyprbazzite/hypr/nightlight.frag}"
            if [[ "${SWAYNC_TOGGLE_STATE:-}" == "true" ]]; then
                hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null
            else
                hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null
            fi ;;
        screenshot:run)  swaync-client -cp -sw; sleep 0.35; screenshot_take region ;;
        picker:run)      swaync-client -cp -sw; sleep 0.35; hyprpicker -a ;;
        lock:run)        swaync-client -cp -sw; sleep 0.35; _lock_now ;;
        *) echo "Usage: hyprbazzite-ctl qs <wifi|bluetooth|speakers|mic|awake|gamemode|nightlight> <state|set> | <screenshot|picker|lock> run"; return 1 ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════════════════════

main() {
    if [[ $# -eq 0 ]]; then
        cat <<'USAGE'
Usage: hyprbazzite-ctl <module> [action] [args...]

Modules:
  menu                          Interactive launcher menu
  qs <name> <state|set|run>     Swaync quick-settings button helper
  gamemode [toggle|status]      Toggle performance gamemode (status prints true/false)
  screenshot [region|area|window|full|clipboard]
  wallpaper [pick]              Interactive wallpaper picker
  chezmoi [push|pull]           Dotfiles management
  refresh                       Restart session apps (waybar, idle, etc.)
  reload                        Reload the Hyprland config, keeping runtime state
  settings                      Quick settings menu
  theme [update] [wallpaper]    Update color theme from wallpaper
  tdp [get|set <watts>|profile] TDP power management
  osk [toggle|swap-anchor]      On-screen keyboard control
  power [profile|menu|shutdown|reboot|suspend|sleep|lock|logout]
  automation [dnd|osk|temp]     Background services & waybar helpers
  waybar [power-status|headset-battery|idle-status|app-name]  Waybar JSON exec modules
  keybinds [macos|linux|toggle|status]
  lid                            Re-sync clamshell/suspend state to the lid
  workspace rebind [init|reflow]  Bind workspaces 1-5/6-10/... to monitors (left to right, top to bottom); init/reflow also move existing ones
  workspace layout [position|internal]  Number by position, or keep the laptop panel on 1-5
  open [browser|files [path]|<target>]  Launch common apps via XDG defaults
USAGE
        return 0
    fi

    local module="$1"; shift

    case "$module" in
        menu) menu_show ;;
        qs) qs "$@" ;;
        gamemode)
            case "${1:-}" in
                status) [[ "$(_animations_enabled)" == "0" ]] && echo true || echo false ;;
                *) gamemode_toggle ;;
            esac
            ;;
        screenshot) screenshot_take "${1:-region}" ;;
        wallpaper) wallpaper_pick ;;
        accent) /usr/libexec/hyprbazzite-accent "$@" ;;
        chezmoi) chezmoi_action "${1:-}" ;;
        refresh) session_refresh ;;
        reload) _reload_config ;;
        settings) quicksettings_show ;;
        theme)
            case "${1:-update}" in
                update) theme_update "${2:-}" ;;
                *) theme_update "$1" ;;
            esac
            ;;
        tdp)
            case "${1:-}" in
                get) tdp_get_current privileged ;;
                set) tdp_set "${2:-}" ;;
                profile) tdp_menu ;;
                *) echo "Usage: hyprbazzite-ctl tdp [get|set <watts>|profile]"; return 1 ;;
            esac
            ;;
        osk)
            case "${1:-toggle}" in
                toggle) osk_toggle ;;
                swap-anchor) osk_swap_anchor ;;
                *) echo "Usage: hyprbazzite-ctl osk [toggle|swap-anchor]"; return 1 ;;
            esac
            ;;
        power)
            case "${1:-menu}" in
                profile) power_profile_cycle ;;
                menu) power_menu ;;
                *) power_action "${1:-}" ;;
            esac
            ;;
        automation)
            case "${1:-}" in
                dnd) automation_dnd ;;
                osk) automation_osk ;;
                temp) automation_temp ;;
                *) echo "Usage: hyprbazzite-ctl automation [dnd|osk|temp]"; return 1 ;;
            esac
            ;;
        waybar)
            case "${1:-}" in
                power-status) waybar_power_status ;;
                headset-battery) waybar_headset_battery ;;
                idle-status) waybar_idle_status ;;
                app-name) waybar_app_name ;;
                *) echo "Usage: hyprbazzite-ctl waybar [power-status|headset-battery|idle-status|app-name]"; return 1 ;;
            esac
            ;;
        keybinds) keybinds_switch "${1:-}" ;;
        lid) lid_sync ;;
        workspace)
            case "${1:-}" in
                rebind) workspace_rebind "${2:-}" ;;
                layout) workspace_layout_set "${2:-}" ;;
                *) echo "Usage: hyprbazzite-ctl workspace <rebind [init|reflow]|layout [position|internal]>"; return 1 ;;
            esac
            ;;
        open)
            local what="${1:-}"; shift || true
            case "$what" in
                browser)                          open_browser ;;
                files|filemanager|file-manager)   open_target "${1:-$HOME}" ;;
                "") echo "Usage: hyprbazzite-ctl open [browser|files [path]|<target>]"; return 1 ;;
                *)  open_target "$what" ;;
            esac
            ;;
        *)
            echo "Unknown module: $module" >&2
            echo "Run 'hyprbazzite-ctl' for usage." >&2
            return 1
            ;;
    esac
}

main "$@"
