#!/usr/bin/env bash
# hyprbazzite-flatpak-setup - first-boot Flatpak provisioning (system-wide).
#
# Runs automatically via hyprbazzite-flatpak-setup.service once the network is
# online, and can be re-run manually (via `ujust install-apps`). It is fully
# idempotent: already-installed apps are skipped, and it only writes its
# done-marker once every app installed successfully — so a transient network
# failure on first boot simply retries on the next boot instead of leaving a
# half-provisioned system.
set -euo pipefail

log() { echo "[flatpak-setup] $*" >&2; }

MARKER="/var/lib/hyprbazzite/flatpak-setup.done"

FLATPAKS=(
    com.discordapp.Discord
    org.prismlauncher.PrismLauncher
    com.bitwarden.desktop
    com.surfshark.Surfshark
    app.zen_browser.zen
)

# --- Ensure the Flathub remote exists (system) ---
flatpak remote-add --if-not-exists --system flathub \
    https://dl.flathub.org/repo/flathub.flatpakrepo || true

# --- Install each app, with retries; skip if already present ---
install_with_retry() {
    local app="$1" attempts=3 i
    if flatpak info --system "$app" >/dev/null 2>&1; then
        log "$app already installed."
        return 0
    fi
    for ((i = 1; i <= attempts; i++)); do
        log "Installing $app (attempt $i/$attempts)..."
        if flatpak install --system --noninteractive --or-update flathub "$app"; then
            return 0
        fi
        sleep 5
    done
    log "WARNING: failed to install $app after $attempts attempts."
    return 1
}

failed=()
for app in "${FLATPAKS[@]}"; do
    install_with_retry "$app" || failed+=("$app")
done

# --- System-wide overrides: fonts + GTK/Qt theming + Wayland ---
log "Applying system-wide Flatpak overrides..."
flatpak override --system \
    --socket=wayland \
    --filesystem=xdg-config/fontconfig:ro \
    --filesystem=/usr/share/fonts:ro \
    --filesystem=xdg-config/gtk-3.0:ro \
    --filesystem=xdg-config/gtk-4.0:ro \
    --filesystem=xdg-config/kdeglobals:ro \
    --filesystem=/usr/share/themes:ro \
    --filesystem=/usr/share/icons:ro \
    --env=GTK_THEME=Dracula \
    --env=QT_QPA_PLATFORMTHEME=gtk3 \
    --env=QT_STYLE_OVERRIDE=Fusion || true

# --- App-specific overrides ---
flatpak override --system --socket=wayland com.discordapp.Discord 2>/dev/null || true
flatpak override --system --filesystem=xdg-download app.zen_browser.zen 2>/dev/null || true

if ((${#failed[@]})); then
    log "Completed with failures: ${failed[*]}. Marker not written; will retry on next boot."
    exit 1
fi

mkdir -p "$(dirname "$MARKER")"
: > "$MARKER"
log "Flatpak setup complete."
