#!/usr/bin/env bash
# hyprbazzite-install-apps - optional developer tooling setup (run: ujust install-apps)
#
# This image does not preinstall Flatpak apps — install those yourself from
# Flathub (theming/integration is already set up by hyprbazzite-flatpak-overrides).
# This command just sets up the optional user-scoped dev extras: Homebrew and
# VSCode. It must run as your normal user (Homebrew refuses to run as root).
set -euo pipefail

log() { echo "[install-apps] $*"; }
notify() {
    local title="$1" msg="$2" urgency="${3:-normal}"
    command -v notify-send >/dev/null 2>&1 && notify-send -u "$urgency" "$title" "$msg" || true
}

if [[ "${EUID}" -eq 0 ]]; then
    log "ERROR: run this as your normal user (not root / not via sudo)."
    exit 1
fi

# --- Homebrew (as the current user) ---
log "Setting up Homebrew..."
if ! command -v brew >/dev/null 2>&1; then
    if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    else
        log "  Installing Homebrew (non-interactive)..."
        NONINTERACTIVE=1 /bin/bash -c \
            "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || \
            log "  Homebrew install failed; skipping brew-based apps."
    fi
fi

if command -v brew >/dev/null 2>&1 || [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" 2>/dev/null || true
    brew tap ublue-os/brew >/dev/null 2>&1 && log "  Added ublue-os/brew tap." || true

    if command -v code >/dev/null 2>&1 || brew list --cask 2>/dev/null | grep -q visual-studio-code; then
        log "  VSCode already installed, skipping..."
    else
        log "  Installing VSCode via Homebrew..."
        brew install --cask visual-studio-code || log "  VSCode install failed."
    fi
fi

log "Done."
notify "Install Apps" "Developer tooling setup finished." "normal"
