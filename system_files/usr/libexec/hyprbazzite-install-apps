#!/usr/bin/env bash
# hyprbazzite-install-apps - manual post-install app setup (run: ujust install-apps)
#
# Flatpaks are normally provisioned automatically on first boot by
# hyprbazzite-flatpak-setup.service. This command lets you (re-)run that
# provisioning on demand and then sets up the user-scoped extras — Homebrew and
# VSCode — which deliberately are NOT automated because Homebrew must run as the
# unprivileged user, not root.
set -euo pipefail

log() { echo "[install-apps] $*"; }
notify() {
    local title="$1" msg="$2" urgency="${3:-normal}"
    command -v notify-send >/dev/null 2>&1 && notify-send -u "$urgency" "$title" "$msg" || true
}

# --- Root guard: Homebrew refuses to run as root, and must not. ---
if [[ "${EUID}" -eq 0 ]]; then
    log "ERROR: run this as your normal user (not root / not via sudo)."
    log "Homebrew must be installed as an unprivileged user."
    exit 1
fi

# --- Internet check ---
if ! curl -s --head --connect-timeout 5 https://flathub.org >/dev/null 2>&1; then
    log "No internet connection. Please connect and retry."
    notify "Install Apps" "No internet connection. Please connect and retry." "critical"
    exit 1
fi

# --- Flatpaks (system): reuse the same routine as the first-boot service. ---
# This needs root, so it's the one part we elevate.
log "Provisioning Flatpaks (may prompt for authentication)..."
if sudo /usr/libexec/hyprbazzite-flatpak-setup; then
    log "Flatpak provisioning complete."
else
    log "Flatpak provisioning reported issues; continuing with the rest."
fi

# --- Homebrew (as the current user) ---
log "Setting up Homebrew..."
if ! command -v brew >/dev/null 2>&1; then
    if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
        eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    else
        log "  Installing Homebrew (non-interactive)..."
        NONINTERACTIVE=1 /bin/bash -c \
            "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || \
            log "  Homebrew install failed; skipping brew-based apps."
    fi
fi

if command -v brew >/dev/null 2>&1 || [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)" 2>/dev/null || true
    brew tap ublue-os/brew >/dev/null 2>&1 && log "  Added ublue-os/brew tap." || true

    # --- VSCode via Homebrew cask ---
    if command -v code >/dev/null 2>&1 || brew list --cask 2>/dev/null | grep -q visual-studio-code; then
        log "  VSCode already installed, skipping..."
    else
        log "  Installing VSCode via Homebrew..."
        brew install --cask visual-studio-code || log "  VSCode install failed."
    fi
fi

log "Installation complete!"
notify "Install Apps" "Application setup finished." "normal"
