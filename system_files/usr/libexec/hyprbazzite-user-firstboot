#!/usr/bin/env bash
# hyprbazzite-user-firstboot - per-user first-login setup.
#
# 1. Once: moves a ~/.config/hypr without hyprland.lua aside (never deleted)
#    so /etc/hypr applies. A user's own hyprland.lua is left alone.
# 2. Replaces links into /usr/share/hyprbazzite/config (older images) with
#    writable copies, and installs missing skel files.
#
# Flatpak theming/integration is handled system-wide by hyprbazzite-flatpak-overrides;
# no Flatpak apps are installed by the image (users install their own).
set -euo pipefail

log() { echo "[user-firstboot] $*" >&2; }

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprbazzite"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
hypr_dir="$config_dir/hypr"
shared_config=/usr/share/hyprbazzite/config
skel=/usr/lib/hyprbazzite/skel

mkdir -p "$state_dir" "$config_dir"

# 1. Hyprland dotfiles. Keeps the original marker, so accounts that already
#    went through this are not touched again.
if [[ ! -f "$state_dir/user-firstboot.done" ]]; then
    if [[ -d "$hypr_dir" && ! -f "$hypr_dir/hyprland.lua" ]]; then
        backup="$hypr_dir.bak-$(date +%Y%m%d-%H%M%S)"
        mv "$hypr_dir" "$backup"
        log "Moved $hypr_dir (no hyprland.lua) to $backup - the system config in /etc/hypr is used now."
    fi
    : > "$state_dir/user-firstboot.done"
fi

# 2. Read-only links -> writable copies. `cp -R` without preserving
#    ownership or SELinux context, so the copies are plain user files.
for link in "$config_dir"/*; do
    [[ -L "$link" ]] || continue
    target=$(readlink "$link")
    [[ "$target" == "$shared_config"/* ]] || continue
    rm "$link"
    if [[ -e "$target" ]]; then
        cp -R "$target" "$link"
        log "Replaced $link (read-only link) with a writable copy."
    else
        log "Removed $link (linked to a default the image no longer ships)."
    fi
done

for f in .zshrc .config/starship.toml; do
    if [[ ! -e "$HOME/$f" && ! -L "$HOME/$f" && -f "$skel/$f" ]]; then
        cp "$skel/$f" "$HOME/$f"
        log "Installed default $HOME/$f."
    fi
done

: > "$state_dir/user-firstboot-v2.done"
log "First-login setup complete."
