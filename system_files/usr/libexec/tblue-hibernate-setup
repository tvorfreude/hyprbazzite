#!/usr/bin/env bash
# tblue-hibernate-setup - Configure hybrid sleep/hibernation for btrfs swapfiles
#
# Sets up resume kernel parameters and configures systemd sleep settings.
# (Wakeup sources are filtered by tblue-disable-nonpower-wakeup.service.)

set -euo pipefail

# -- Configuration -----------------------------------------------------------
readonly SWAPFILE_PATH="/var/swap/swapfile"

# -- Helpers ------------------------------------------------------------------

log() {
    echo "[tblue-hibernate-setup] $*" >&2
}

# Size the swapfile a little larger than RAM so systemd can always fit the
# hibernation image (it refuses if usable swap < in-use memory).
swapfile_size_mib() {
    local mem_kib ram_mib
    mem_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    ram_mib=$(( (mem_kib + 1023) / 1024 ))   # RAM in MiB, rounded up
    echo $(( ram_mib + 2048 ))               # + 2 GiB headroom
}

# Create a hibernation-capable swapfile on btrfs if one isn't already present.
# btrfs requires the swapfile to be NOCOW and fully preallocated; the
# `btrfs filesystem mkswapfile` helper does all of that (and runs mkswap).
ensure_swapfile() {
    # Treat only a non-empty file as "already provisioned".
    if [[ -s "$SWAPFILE_PATH" ]]; then
        return 0
    fi
    rm -f "$SWAPFILE_PATH"
    mkdir -p "$(dirname "$SWAPFILE_PATH")"

    local size_mib
    size_mib=$(swapfile_size_mib)
    log "No swapfile found; creating a ${size_mib} MiB swapfile at $SWAPFILE_PATH"

    if btrfs filesystem mkswapfile --size "${size_mib}m" --uuid clear "$SWAPFILE_PATH" 2>/dev/null; then
        log "Created swapfile via 'btrfs filesystem mkswapfile'."
    else
        # Fallback for older btrfs-progs without the mkswapfile subcommand.
        log "'btrfs filesystem mkswapfile' unavailable; creating manually (NOCOW + dd)."
        rm -f "$SWAPFILE_PATH"
        truncate -s 0 "$SWAPFILE_PATH"
        chattr +C "$SWAPFILE_PATH"                 # NOCOW must be set while empty
        dd if=/dev/zero of="$SWAPFILE_PATH" bs=1M count="$size_mib" status=none
        chmod 600 "$SWAPFILE_PATH"
        mkswap "$SWAPFILE_PATH"
    fi
}

# -- Main ---------------------------------------------------------------------

main() {
    # btrfs only: the swapfile relies on `btrfs filesystem mkswapfile` (or
    # NOCOW) and `btrfs inspect-internal map-swapfile` for its resume offset.
    # On any other root this failed on every boot, since the done-marker is
    # only written on success. Exiting 0 lets the unit mark itself done.
    if [[ "$(stat -f -c %T /var)" != "btrfs" ]]; then
        log "/var is not on btrfs; skipping swapfile and hibernation setup."
        exit 0
    fi

    # Kernel lockdown (Secure Boot) disables hibernation outright - see the
    # karg notes below - so don't spend RAM+2GiB of disk on a swapfile that
    # can never hold a hibernation image. Checked via lockdown, not
    # /sys/power/state: Bazzite's own nohibernate karg (removed below) also
    # hides "disk" there until the next boot.
    if grep -qE '\[(integrity|confidentiality)\]' /sys/kernel/security/lockdown 2>/dev/null; then
        log "Kernel lockdown is active (Secure Boot): hibernation is unavailable, skipping."
        log "After disabling Secure Boot, re-run with: sudo rm /var/lib/tblue/hibernate-setup.done && sudo systemctl start tblue-hibernate-setup"
        exit 0
    fi

    # 1. Ensure the swapfile exists (create it if missing), then fstab + activate.
    ensure_swapfile

    if ! grep -q "$SWAPFILE_PATH" /etc/fstab; then
        echo "$SWAPFILE_PATH none swap defaults,nofail 0 0" >> /etc/fstab
        log "Added swapfile to /etc/fstab"
    fi

    # Activate now so swap is usable this boot (the resume= karg set below still
    # needs a reboot before hibernation actually works).
    if ! swapon --show=NAME --noheadings 2>/dev/null | grep -qx "$SWAPFILE_PATH"; then
        swapon "$SWAPFILE_PATH" || log "Warning: swapon failed; fstab will retry next boot."
    fi

    # 2. Get the decrypted device UUID and swapfile offset
    local dec_uuid
    dec_uuid=$(findmnt -no UUID -T "$SWAPFILE_PATH")
    if [[ -z "$dec_uuid" ]]; then
        log "Error: Could not determine Decrypted UUID"
        exit 1
    fi

    local offset
    offset=$(btrfs inspect-internal map-swapfile -r "$SWAPFILE_PATH" | head -n1)
    if [[ -z "$offset" ]]; then
        log "Error: Could not determine swapfile offset"
        exit 1
    fi

    log "Setting resume=UUID=$dec_uuid and resume_offset=$offset for hybrid sleep."

    # 3. Set kernel arguments for resume.
    # Use --append-if-missing (not --replace): on a fresh install the resume
    # kargs don't exist yet, and --replace fails on a missing key.
    # Also strip 'nohibernate', which Bazzite/uBlue ships by default -- while
    # it is present the kernel reports /sys/power/disk as [disabled] and
    # neither hibernate nor suspend-then-hibernate can run at all. This karg
    # is necessary but not always sufficient: Secure Boot puts the kernel in
    # lockdown=integrity mode independently, which disables hibernation on
    # its own regardless of kargs - confirmed live on real hardware: even
    # with nohibernate successfully removed and resume kargs correctly set,
    # /sys/power/state still had no "disk" entry and CanHibernate/
    # CanSuspendThenHibernate both reported "na". There's no karg or sleep.conf
    # setting that overrides that (it's intentional - an unsigned hibernation
    # image could otherwise be used to tamper with a verified-boot kernel on
    # resume), so hyprbazzite-ctl's _sleep_best_effort() and
    # HandleLidSwitch=sleep (logind.conf.d) use logind's own SleepOperation=
    # fallback chain instead of ever hardcoding suspend-then-hibernate
    # directly, so actual sleep still works on hardware where hibernation
    # just isn't available for this reason.
    # Guarded so steady-state boots skip the (slow) rpm-ostree transaction.
    # NOTE: applied kargs require a reboot to take effect.
    # resume_delay=5 used to be appended here, but the kernel parameter is
    # resumedelay= (no underscore), so it was a no-op. The real resume runs
    # from the initramfs, which ignores that delay anyway, while the correctly
    # spelled one would add 5s to every boot. Installs provisioned before this
    # keep the harmless leftover until the setup is re-run (remove
    # /var/lib/tblue/hibernate-setup.done), which then deletes it - not worth
    # a forced rpm-ostree transaction on every machine.
    local kargs
    kargs=$(rpm-ostree kargs | tr ' ' '\n')
    if grep -qx 'nohibernate' <<<"$kargs" \
       || ! grep -q '^resume=' <<<"$kargs" \
       || grep -qx 'resume_delay=5' <<<"$kargs"; then
        log "Provisioning hibernation kargs (remove nohibernate/resume_delay, add resume; reboot required)."
        rpm-ostree kargs \
            --delete-if-present="nohibernate" \
            --append-if-missing="resume=UUID=$dec_uuid" \
            --append-if-missing="resume_offset=$offset" \
            --delete-if-present="resume_delay=5"
    else
        log "Hibernation kargs already provisioned; leaving kargs unchanged."
    fi

    # The sleep settings themselves (Allow{Suspend,Hibernation,
    # SuspendThenHibernate}=yes) ship as sleep.conf.d drop-ins.
    log "Hybrid sleep setup complete."
}

main "$@"
